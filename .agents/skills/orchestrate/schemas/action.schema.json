{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/schemas/action.schema.json",
  "title": "Native Dispatch Runner Spawn Action",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "action",
    "dispatch_id",
    "run_id",
    "wave_id",
    "step_id",
    "applies_to_steps",
    "role",
    "agent_ordinal",
    "agent_count",
    "agent_name",
    "initial_prompt",
    "capability_ref",
    "target",
    "mode",
    "mutation_policy",
    "write_scope",
    "forbidden_write_scopes",
    "briefing_binding",
    "input_refs",
    "output_refs"
  ],
  "properties": {
    "schema_version": {"const": "arcanum.native-dispatch-runner.action.v0.1"},
    "action_id": {"type": "string", "pattern": "^spawn-[0-9]{4}$"},
    "action": {"const": "spawn"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "applies_to_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "role": {"type": "string", "minLength": 1},
    "agent_ordinal": {"type": "integer", "minimum": 0},
    "agent_count": {"type": "integer", "minimum": 1},
    "agent_name": {"type": "string", "minLength": 1},
    "initial_prompt": {"type": "string", "minLength": 1},
    "capability_ref": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "mutation_policy": {"type": "string", "enum": ["read-only", "proposal-only", "lifecycle-owned", "artifact-only"]},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "forbidden_write_scopes": {"type": "array", "items": {"type": "string"}},
    "briefing_binding": {"$ref": "#/$defs/role_briefing_binding"},
    "input_refs": {"type": "array", "items": {"type": "string"}},
    "output_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "role_briefing_binding": {
      "type": "object",
      "required": ["contract_version", "source_binding", "briefing", "briefing_sha256"],
      "properties": {
        "contract_version": {"const": "arcanum.confirmed-role-briefing.v0.1"},
        "source_binding": {
          "type": "object",
          "required": ["artifact_path", "artifact_sha256", "selector", "selected_payload_sha256"],
          "properties": {
            "artifact_path": {"type": "string", "minLength": 1},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "selector": {"type": "string", "pattern": "^/"},
            "selected_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "briefing": {
          "type": "object",
          "required": ["agent_identity", "angle", "instructions", "status_semantics", "read_policy", "write_policy", "receipt_shape", "authority_ceiling"],
          "properties": {
            "agent_identity": {"type": "string", "minLength": 1},
            "angle": {"type": "string", "minLength": 1},
            "instructions": {"type": "string", "minLength": 1},
            "status_semantics": {
              "type": "object",
              "required": ["task_status_field", "task_complete_value", "task_blocked_value", "domain_gate_status_field", "domain_gate_is_separate"],
              "properties": {
                "task_status_field": {"type": "string", "minLength": 1},
                "task_complete_value": {"type": "string", "minLength": 1},
                "task_blocked_value": {"type": "string", "minLength": 1},
                "domain_gate_status_field": {"type": "string", "minLength": 1},
                "domain_gate_is_separate": {"const": true}
              },
              "additionalProperties": false
            },
            "read_policy": {
              "type": "object",
              "required": ["input_refs", "allowed_read_scopes", "forbidden_read_scopes", "required_input_refs_readable"],
              "properties": {
                "input_refs": {"type": "array", "items": {"type": "string"}},
                "allowed_read_scopes": {"type": "array", "items": {"type": "string"}},
                "forbidden_read_scopes": {"type": "array", "items": {"type": "string"}},
                "required_input_refs_readable": {"const": true}
              },
              "additionalProperties": false
            },
            "write_policy": {
              "type": "object",
              "required": ["mutation_policy", "write_scope", "forbidden_write_scopes"],
              "properties": {
                "mutation_policy": {"type": "string", "enum": ["read-only", "proposal-only", "lifecycle-owned", "artifact-only"]},
                "write_scope": {"type": "array", "items": {"type": "string"}},
                "forbidden_write_scopes": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            },
            "receipt_shape": {
              "type": "object",
              "required": ["required_fields", "completion_requires_all_fields"],
              "properties": {
                "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "completion_requires_all_fields": {"const": true}
              },
              "additionalProperties": false
            },
            "authority_ceiling": {
              "type": "object",
              "required": ["summary", "allowed_actions", "forbidden_actions"],
              "properties": {
                "summary": {"type": "string", "minLength": 1},
                "allowed_actions": {"type": "array", "items": {"type": "string"}},
                "forbidden_actions": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "briefing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
