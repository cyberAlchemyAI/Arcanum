{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/schemas/run-plan.schema.json",
  "title": "Native Dispatch Runner Current-Wave Run Plan",
  "type": "object",
  "required": ["schema_version", "dispatch_id", "run_id", "state", "validation_status", "selected_wave", "action_artifacts", "actions"],
  "properties": {
    "schema_version": {"const": "arcanum.native-dispatch-runner.run-plan.v0.1"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"const": "wave_ready"},
    "validation_status": {"const": "pass"},
    "selected_wave": {
      "type": "object",
      "required": ["wave_id", "role_ids", "parallel", "join_policy", "depends_on_waves", "gate_after", "on_incomplete"],
      "properties": {
        "wave_id": {"type": "string", "minLength": 1},
        "role_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "parallel": {"type": "boolean"},
        "join_policy": {"type": "string"},
        "depends_on_waves": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "gate_after": {"type": ["string", "null"]},
        "on_incomplete": {"type": "string"}
      },
      "additionalProperties": false
    },
    "action_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^actions/spawn-[0-9]{4}\\.json$"}},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "action.schema.json"}
    }
  },
  "additionalProperties": false
}
