    "validator": {"type": "object", "additionalProperties": false, "required": ["identity", "owner", "path", "sha256"], "properties": {"identity": {"const": "invoke.validate-design-input-closure.v2"}, "owner": {"const": "invoke-design-input-closure-validator"}, "path": {"const": "arcanum/spells/invoke/scripts/validate_design_input_closure_v2.py"}, "sha256": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/digest"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["process_ref", "design_input_closure_ref", "boundary_approval_ref", "define_stage_receipt_ref", "define_admission_receipt_ref", "prior_design_stage_receipt_ref", "prior_design_admission_receipt_ref", "closure_digest", "discovery_boundary_digest"], "properties": {"process_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, "design_input_closure_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, "boundary_approval_ref": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, {"type": "null"}]}, "define_stage_receipt_ref": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, {"type": "null"}]}, "define_admission_receipt_ref": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, {"type": "null"}]}, "prior_design_stage_receipt_ref": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, {"type": "null"}]}, "prior_design_admission_receipt_ref": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, {"type": "null"}]}, "closure_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/digest"}, "discovery_boundary_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/digest"}}},
