    "discovery": {"type": "object", "additionalProperties": false, "required": ["inventory", "inventory_digest", "cataloged_paths", "excluded_paths", "unclassified_paths", "ambiguous_paths", "per_class"], "properties": {"inventory": {"type": "array", "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/discoveredCandidate"}}, "inventory_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/digest"}, "cataloged_paths": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/pathSet"}, "excluded_paths": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/pathSet"}, "unclassified_paths": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/pathSet"}, "ambiguous_paths": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/pathSet"}, "per_class": {"type": "array", "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/classResult"}}}},
    "check": {"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/checkResult"}, {"properties": {"check_id": {"enum": ["closure-schema", "closure-digest", "process-binding", "boundary-approval", "define-predecessor-admission", "path-safety", "boundary-freshness", "discovery-enumeration", "catalog-closure", "input-freshness", "visibility", "conditional-resolution", "conflict-closure", "prior-design", "design-predecessor-admission", "scope-signal-coverage", "manifest-projection"]}}}]},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "code", "message", "selector", "owner", "repair_route"], "properties": {"blocker_id": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/id"}, "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}, "message": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/nonEmpty"}, "selector": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/nonEmpty"}, {"type": "null"}]}, "owner": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/id"}, "repair_route": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/nonEmpty"}}}
  }
