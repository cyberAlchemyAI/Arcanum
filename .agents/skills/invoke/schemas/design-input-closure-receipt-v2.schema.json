    {"if": {"properties": {"verdict": {"const": "block"}}, "required": ["verdict"]}, "then": {"properties": {"blockers": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "pass"}, "activation_kind": {"const": "normal"}}, "required": ["verdict", "activation_kind"]}, "then": {"properties": {"bindings": {"properties": {"define_stage_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, "define_admission_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}}}}}},
    {"if": {"properties": {"verdict": {"const": "pass"}, "design_kind": {"const": "evolution"}}, "required": ["verdict", "design_kind"]}, "then": {"properties": {"bindings": {"properties": {"prior_design_stage_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}, "prior_design_admission_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/exactRef"}}}}}}
