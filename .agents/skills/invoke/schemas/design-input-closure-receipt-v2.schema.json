    "expected_manifest": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["manifest_id", "input_digest"], "properties": {"manifest_id": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/id"}, "input_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-input-closure-receipt/v1#/$defs/digest"}}}, {"type": "null"}]},
    "checks": {"type": "array", "minItems": 17, "maxItems": 17, "prefixItems": [
