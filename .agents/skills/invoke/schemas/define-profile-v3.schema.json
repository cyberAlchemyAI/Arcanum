{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/define-profile/v3",
  "title": "Invoke Generic Definitions Profile v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profile_id", "public_contract", "v2_compatibility_policy", "outputs"],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/define-profile/v3"},
    "schema_version": {"const": "invoke.define-profile.v3"},
    "profile_id": {"const": "invoke.generic-definitions-baseline.v3"},
    "public_contract": {"const": true},
    "v2_compatibility_policy": {"const": "preserve-byte-and-validate-only"},
    "outputs": {
      "type": "array",
      "const": [
        "semantic-context",
        "semantic-closure-receipt",
        "spec",
        "definitions",
        "definitions-view",
        "glossary",
        "layering",
        "template-selection",
        "dispatch-trace",
        "distill",
        "identity-denominator",
        "transport",
        "stage-receipt"
      ]
    }
  }
}
