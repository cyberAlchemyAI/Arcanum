{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/define-source-v1",
  "title": "Invoke Define Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "target", "discovery", "template_selection", "spec_declarations", "glossary", "layering", "dispatch_trace", "distill", "identity_denominator", "output_contracts", "transport_policy", "next_route"],
  "properties": {
    "schema_version": {"const": "invoke.define-source.v1"},
    "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["id", "objective"],
      "properties": {"id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}}
    },
    "discovery": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "ref"], "properties": {"kind": {"const": "artifact"}, "ref": {"$ref": "#/$defs/exact_ref"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "waiver_reason"], "properties": {"kind": {"const": "waiver"}, "waiver_reason": {"type": "string", "minLength": 8}}}
      ]
    },
    "template_selection": {
      "type": "object", "additionalProperties": false, "required": ["profile_id", "selected", "eligible", "tie"],
      "properties": {
        "profile_id": {"const": "invoke.generic-spec-baseline.v1"},
        "selected": {"const": "invoke.generic-spec-baseline.v1"},
        "eligible": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tie": {"const": false}
      }
    },
    "spec_declarations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "statement"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}}}},
    "glossary": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["term", "definition", "link_status", "rationale"], "properties": {"term": {"type": "string", "minLength": 1}, "definition": {"type": "string", "minLength": 1}, "link_status": {"enum": ["linked", "partial", "no-match"]}, "rationale": {"type": "string"}}}},
    "layering": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "decision", "minimum_unit"], "properties": {"kind": {"const": "seed"}, "decision": {"type": "string", "minLength": 1}, "minimum_unit": {"type": "string", "minLength": 1}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "rationale"], "properties": {"kind": {"const": "gap"}, "rationale": {"type": "string", "minLength": 8}}}
    ]},
    "dispatch_trace": {"type": "object", "additionalProperties": false, "required": ["techniques"], "properties": {"techniques": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "distill": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["classification", "verdict", "evidence"], "properties": {"classification": {"const": "required"}, "verdict": {"const": "pass"}, "evidence": {"type": "string", "minLength": 1}}},
      {"type": "object", "additionalProperties": false, "required": ["classification", "rationale"], "properties": {"classification": {"const": "not-required"}, "rationale": {"type": "string", "minLength": 8}}}
    ]},
    "identity_denominator": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["classification", "request_ref", "result_ref"], "properties": {"classification": {"const": "required"}, "request_ref": {"$ref": "#/$defs/exact_ref"}, "result_ref": {"$ref": "#/$defs/exact_ref"}}},
      {"type": "object", "additionalProperties": false, "required": ["classification", "rationale"], "properties": {"classification": {"const": "not-applicable"}, "rationale": {"type": "string", "minLength": 8}}}
    ]},
    "output_contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["spec", "glossary", "layering", "template_selection", "dispatch_trace", "distill", "identity_denominator", "transport", "stage_receipt"],
      "properties": {
        "spec": {"const": "SPEC.md"}, "glossary": {"const": "GLOSSARY.md"}, "layering": {"enum": ["IMPLEMENTATION-LAYERING.md", "LAYERING-GAP.md"]},
        "template_selection": {"const": "TEMPLATE-SELECTION-RECEIPT.json"}, "dispatch_trace": {"const": "DISPATCH-TRACE.json"},
        "distill": {"const": "DISTILL-RECEIPT.json"}, "identity_denominator": {"const": "IDENTITY-DENOMINATOR-RECEIPT.json"},
        "transport": {"const": "DEFINE-TRANSPORT-REPORT.json"}, "stage_receipt": {"const": "INVOKE-DEFINE-STAGE-RECEIPT.json"}
      }
    },
    "transport_policy": {
      "type": "object", "additionalProperties": false, "required": ["append_existing_only", "upstream_mutation", "targets"],
      "properties": {"append_existing_only": {"const": true}, "upstream_mutation": {"const": false}, "targets": {"type": "array", "maxItems": 0}}
    },
    "next_route": {"enum": ["design", "spellcraft", "sigil-development", "deferred"]}
  },
  "$defs": {"exact_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0}}}}
}
