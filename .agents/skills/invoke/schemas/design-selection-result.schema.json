{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-selection-result/1-0-0",
  "title": "InvokeDesignSelectionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_input_digest",
    "denominator_receipt_digest",
    "concerns",
    "selected_outputs",
    "pass_1_digest",
    "pass_2_digest",
    "fixed_point",
    "evidence_state",
    "verdict",
    "diagnostics",
    "result_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "manifest_input_digest": {"$ref": "#/$defs/digest"},
    "denominator_receipt_digest": {"$ref": "#/$defs/digest"},
    "concerns": {
      "type": "array",
      "items": {"$ref": "#/$defs/concern"}
    },
    "selected_outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "pass_1_digest": {"$ref": "#/$defs/digest"},
    "pass_2_digest": {"$ref": "#/$defs/digest"},
    "fixed_point": {"type": "boolean"},
    "evidence_state": {
      "enum": ["authored-complete", "design-validator-pass"]
    },
    "verdict": {"enum": ["pass", "block"]},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "result_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "fixed_point": {"const": true},
          "evidence_state": {"const": "design-validator-pass"},
          "diagnostics": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"verdict": {"const": "block"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "fixed_point": {"const": false},
          "evidence_state": {"const": "authored-complete"},
          "diagnostics": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_owner",
        "contributing_owners",
        "artifact_owner",
        "validator_owner"
      ],
      "properties": {
        "accountable_owner": {"$ref": "#/$defs/id"},
        "contributing_owners": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "artifact_owner": {"$ref": "#/$defs/id"},
        "validator_owner": {"const": "invoke-design-selection-validator"}
      }
    },
    "predicateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_predicate", "detector_negative", "evidence_selectors"],
      "properties": {
        "required_predicate": {"type": "boolean"},
        "detector_negative": {"type": "boolean"},
        "evidence_selectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concern_id",
        "signal_ids",
        "primary_class",
        "ownership",
        "disposition",
        "predicate_evidence",
        "output_id",
        "selected",
        "rationale",
        "revisit_condition"
      ],
      "properties": {
        "concern_id": {"$ref": "#/$defs/id"},
        "signal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "primary_class": {
          "enum": [
            "authority",
            "security",
            "state-event",
            "persistence",
            "failure",
            "reliability",
            "integration",
            "migration",
            "rollout",
            "privacy-data",
            "performance",
            "ux",
            "validation"
          ]
        },
        "ownership": {"$ref": "#/$defs/ownership"},
        "disposition": {
          "enum": [
            "required",
            "recommended",
            "not-applicable-with-rationale",
            "block"
          ]
        },
        "predicate_evidence": {"$ref": "#/$defs/predicateEvidence"},
        "output_id": {
          "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "selected": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1},
        "revisit_condition": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "required"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "selected": {"const": true},
              "output_id": {"$ref": "#/$defs/id"},
              "predicate_evidence": {
                "properties": {"required_predicate": {"const": true}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": ["recommended", "not-applicable-with-rationale", "block"]
              }
            },
            "required": ["disposition"]
          },
          "then": {"properties": {"selected": {"const": false}}}
        },
        {
          "if": {
            "properties": {
              "disposition": {"const": "not-applicable-with-rationale"}
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "predicate_evidence": {
                "properties": {
                  "required_predicate": {"const": false},
                  "detector_negative": {"const": true},
                  "evidence_selectors": {"minItems": 1}
                }
              },
              "output_id": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"disposition": {"const": "recommended"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "revisit_condition": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "selector", "owner", "repair"],
      "properties": {
        "code": {
          "enum": [
            "MANIFEST_NOT_CLOSED",
            "MISSING_DETECTOR_INPUT",
            "STALE_DENOMINATOR_RECEIPT",
            "SELF_ISSUED_RECEIPT",
            "UNBOUND_SIGNAL",
            "OWNER_UNRESOLVED",
            "FALSE_NA",
            "ILLEGAL_SELECTION",
            "CHANGED_PASS_TWO",
            "ILLEGAL_EVIDENCE_STATE"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "selector": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]},
        "repair": {"type": "string", "minLength": 1}
      }
    }
  }
}
