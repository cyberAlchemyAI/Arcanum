{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-bundle-closure/v1",
  "title": "Invoke Design Bundle Closure v1",
  "description": "Canonical W3 input envelope binding one exact W2 candidate, real Distill evidence, and the fixed final Design output names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "closure_id",
    "target_id",
    "candidate_receipt_ref",
    "distill_evidence",
    "output_contracts",
    "authority_effect",
    "closure_digest"
  ],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-bundle-closure/v1"},
    "schema_version": {"const": "invoke.design-bundle-closure.v1"},
    "closure_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "candidate_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "distill_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_ref", "events_ref", "execution_receipt_ref", "validation_result_ref"],
      "properties": {
        "request_ref": {"$ref": "#/$defs/exactRef"},
        "events_ref": {"$ref": "#/$defs/exactRef"},
        "execution_receipt_ref": {"$ref": "#/$defs/exactRef"},
        "validation_result_ref": {"$ref": "#/$defs/exactRef"}
      }
    },
    "output_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_artifact",
        "architecture",
        "selected_companions",
        "glossary_consistency",
        "planned_witnesses",
        "layering",
        "template_selection",
        "dispatch_trace",
        "distill",
        "scope_manifest",
        "denominator_receipt",
        "selection_result",
        "coherence_receipt",
        "transport",
        "stage_receipt"
      ],
      "properties": {
        "design_artifact": {"const": "DESIGN.json"},
        "architecture": {"const": "ARCHITECTURE.md"},
        "selected_companions": {"const": "SELECTED-COMPANIONS.md"},
        "glossary_consistency": {"const": "GLOSSARY-CONSISTENCY-REPORT.json"},
        "planned_witnesses": {"const": "PLANNED-WITNESS-CONTRACTS.json"},
        "layering": {"const": "IMPLEMENTATION-LAYERING.md"},
        "template_selection": {"const": "TEMPLATE-SELECTION-RECEIPT.json"},
        "dispatch_trace": {"const": "DISPATCH-TRACE.json"},
        "distill": {"const": "DISTILL-RECEIPT.json"},
        "scope_manifest": {"const": "DESIGN-SCOPE-MANIFEST.json"},
        "denominator_receipt": {"const": "DESIGN-DENOMINATOR-RECEIPT.json"},
        "selection_result": {"const": "DESIGN-SELECTION-RESULT.json"},
        "coherence_receipt": {"const": "DESIGN-COHERENCE-RECEIPT.json"},
        "transport": {"const": "DESIGN-TRANSPORT-REPORT.json"},
        "stage_receipt": {"const": "INVOKE-DESIGN-STAGE-RECEIPT.json"}
      }
    },
    "authority_effect": {"const": "none"},
    "closure_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
