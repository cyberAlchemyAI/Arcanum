{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/define-profile-v1",
  "title": "Invoke Generic Define Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "public_contract", "historical_template_policy", "outputs"],
  "properties": {
    "schema_version": {"const": "invoke.define-profile.v1"},
    "profile_id": {"const": "invoke.generic-spec-baseline.v1"},
    "public_contract": {"const": true},
    "historical_template_policy": {"const": "compatibility-read-only"},
    "outputs": {
      "type": "array",
      "const": ["spec", "glossary", "layering", "template-selection", "dispatch-trace", "distill", "identity-denominator", "transport", "stage-receipt"]
    }
  }
}
