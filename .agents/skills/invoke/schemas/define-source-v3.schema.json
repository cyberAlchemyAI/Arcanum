{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/define-source/v3",
  "title": "Invoke Define Source v3",
  "description": "Sole authored semantic source for a Define v3 candidate bundle. It consumes an exact ready-for-define semantic closure and applies every concept disposition without redefining canonical authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "source_id",
    "profile_id",
    "upstream_bindings",
    "template_selection",
    "spec_declarations",
    "definition_registry",
    "semantic_applications",
    "layering",
    "dispatch_trace",
    "distill",
    "identity_denominator",
    "output_contracts",
    "transport_policy",
    "next_route",
    "authority_effect"
  ],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/define-source/v3"},
    "schema_version": {"const": "invoke.define-source.v3"},
    "source_id": {"$ref": "#/$defs/id"},
    "profile_id": {"const": "invoke.generic-definitions-baseline.v3"},
    "upstream_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_context_ref", "semantic_closure_receipt_ref"],
      "properties": {
        "semantic_context_ref": {"$ref": "#/$defs/exactRef"},
        "semantic_closure_receipt_ref": {"$ref": "#/$defs/exactRef"}
      }
    },
    "template_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "selected", "eligible", "tie"],
      "properties": {
        "profile_id": {"const": "invoke.generic-definitions-baseline.v3"},
        "selected": {"const": "invoke.generic-definitions-baseline.v3"},
        "eligible": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "invoke.generic-definitions-baseline.v3"},
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "tie": {"const": false}
      }
    },
    "spec_declarations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "statement"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"$ref": "#/$defs/nonEmpty"},
          "statement": {"$ref": "#/$defs/nonEmpty"}
        }
      }
    },
    "definition_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "title", "owner_route", "authority_scope", "visibility", "definitions", "authority_bindings"],
      "properties": {
        "registry_id": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v1#/$defs/stable_id"},
        "title": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v1#/$defs/non_empty_string"},
        "owner_route": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v1#/$defs/non_empty_string"},
        "authority_scope": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v1#/$defs/authority_scope"},
        "visibility": {"enum": ["public", "private"]},
        "definitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v2#/$defs/candidateDefinition"}
        },
        "authority_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v2#/$defs/authorityBinding"}
        }
      },
      "anyOf": [
        {"properties": {"definitions": {"minItems": 1}}},
        {"properties": {"authority_bindings": {"minItems": 1}}}
      ]
    },
    "semantic_applications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://arcanum.dev/schemas/invoke/definitions/v2#/$defs/semanticApplication"}
    },
    "layering": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "decision", "minimum_unit"],
          "properties": {
            "kind": {"const": "seed"},
            "decision": {"$ref": "#/$defs/nonEmpty"},
            "minimum_unit": {"$ref": "#/$defs/nonEmpty"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rationale"],
          "properties": {
            "kind": {"const": "gap"},
            "rationale": {"type": "string", "minLength": 8, "pattern": ".*\\S.*"}
          }
        }
      ]
    },
    "dispatch_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["techniques"],
      "properties": {
        "techniques": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        }
      }
    },
    "distill": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "verdict", "evidence"],
          "properties": {
            "classification": {"const": "required"},
            "verdict": {"const": "pass"},
            "evidence": {"$ref": "#/$defs/nonEmpty"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "rationale"],
          "properties": {
            "classification": {"const": "not-required"},
            "rationale": {"type": "string", "minLength": 8, "pattern": ".*\\S.*"}
          }
        }
      ]
    },
    "identity_denominator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "request_ref", "result_ref"],
          "properties": {
            "classification": {"const": "required"},
            "request_ref": {"$ref": "#/$defs/exactRef"},
            "result_ref": {"$ref": "#/$defs/exactRef"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "rationale"],
          "properties": {
            "classification": {"const": "not-applicable"},
            "rationale": {"type": "string", "minLength": 8, "pattern": ".*\\S.*"}
          }
        }
      ]
    },
    "output_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_context",
        "semantic_closure_receipt",
        "spec",
        "definitions",
        "definitions_view",
        "glossary",
        "layering",
        "template_selection",
        "dispatch_trace",
        "distill",
        "identity_denominator",
        "transport",
        "stage_receipt"
      ],
      "properties": {
        "semantic_context": {"const": "DEFINE-SEMANTIC-CONTEXT.json"},
        "semantic_closure_receipt": {"const": "DEFINE-SEMANTIC-CLOSURE-RECEIPT.json"},
        "spec": {"const": "SPEC.md"},
        "definitions": {"const": "DEFINITIONS.json"},
        "definitions_view": {"const": "DEFINITIONS.md"},
        "glossary": {"const": "GLOSSARY.md"},
        "layering": {"enum": ["IMPLEMENTATION-LAYERING.md", "LAYERING-GAP.md"]},
        "template_selection": {"const": "TEMPLATE-SELECTION-RECEIPT.json"},
        "dispatch_trace": {"const": "DISPATCH-TRACE.json"},
        "distill": {"const": "DISTILL-RECEIPT.json"},
        "identity_denominator": {"const": "IDENTITY-DENOMINATOR-RECEIPT.json"},
        "transport": {"const": "DEFINE-TRANSPORT-REPORT.json"},
        "stage_receipt": {"const": "INVOKE-DEFINE-STAGE-RECEIPT.json"}
      }
    },
    "transport_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["append_existing_only", "upstream_mutation", "targets"],
      "properties": {
        "append_existing_only": {"const": true},
        "upstream_mutation": {"const": false},
        "targets": {"type": "array", "maxItems": 0}
      }
    },
    "next_route": {"enum": ["design", "spellcraft", "sigil-development", "deferred"]},
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "definition_registry": {
            "properties": {"visibility": {"const": "public"}},
            "required": ["visibility"]
          }
        },
        "required": ["definition_registry"]
      },
      "then": {
        "properties": {
          "definition_registry": {
            "properties": {
              "definitions": {
                "items": {
                  "properties": {
                    "source_refs": {
                      "items": {
                        "properties": {"visibility": {"const": "public"}},
                        "required": ["visibility"]
                      }
                    }
                  }
                }
              },
              "authority_bindings": {
                "items": {
                  "properties": {
                    "authority_ref": {
                      "properties": {"visibility": {"const": "public"}},
                      "required": ["visibility"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "The compiler must prove total equality between the ready closure, semantic applications, candidate definitions, and authority bindings. JSON Schema cannot establish that equality or semantic scope narrowing.",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmpty": {"type": "string", "pattern": ".*\\S.*"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
