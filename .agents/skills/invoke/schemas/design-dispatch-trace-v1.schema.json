{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-dispatch-trace/v1",
  "title": "Invoke Design Dispatch Trace v1",
  "description": "Deterministic projection of the authored W2 Dispatch technique trace; it is not execution evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "trace_id", "target_id", "design_artifact_ref",
    "techniques", "trace_evidence_ref", "trace_state", "execution_state",
    "plan_evidence_state", "authority_effect", "trace_digest"
  ],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-dispatch-trace/v1"},
    "schema_version": {"const": "invoke.design-dispatch-trace.v1"},
    "trace_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "design_artifact_ref": {"$ref": "#/$defs/exactRef"},
    "techniques": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "trace_evidence_ref": {"$ref": "#/$defs/exactRef"},
    "trace_state": {"const": "authored-complete"},
    "execution_state": {"const": "not-executed"},
    "plan_evidence_state": {"const": "plan-evidence-pending"},
    "authority_effect": {"const": "none"},
    "trace_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "exactRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}}
    }
  }
}
