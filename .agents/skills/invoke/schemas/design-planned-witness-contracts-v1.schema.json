{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-planned-witness-contracts/v1",
  "title": "Invoke Design Planned Witness Contracts v1",
  "description": "Deterministic projection of W2 witness plans; every witness remains unexecuted and cannot establish Plan evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "contract_set_id", "target_id", "design_artifact_ref",
    "witnesses", "evidence_state", "execution_state", "plan_evidence_state",
    "promotion_state", "authority_effect", "contract_set_digest"
  ],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-planned-witness-contracts/v1"},
    "schema_version": {"const": "invoke.design-planned-witness-contracts.v1"},
    "contract_set_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "design_artifact_ref": {"$ref": "#/$defs/exactRef"},
    "witnesses": {"type": "array", "items": {"$ref": "#/$defs/witness"}},
    "evidence_state": {"const": "authored-complete"},
    "execution_state": {"const": "not-executed"},
    "plan_evidence_state": {"const": "plan-evidence-pending"},
    "promotion_state": {"const": "not-promoted"},
    "authority_effect": {"const": "none"},
    "contract_set_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "idSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "exactRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}}
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id", "claim_id", "concern_id", "polarity", "target_fact_ids",
        "input_or_violation", "expected_result", "execution_owner", "execution_phase", "evidence_state"
      ],
      "properties": {
        "witness_id": {"$ref": "#/$defs/id"},
        "claim_id": {"$ref": "#/$defs/id"},
        "concern_id": {"$ref": "#/$defs/id"},
        "polarity": {"enum": ["positive", "negative"]},
        "target_fact_ids": {"$ref": "#/$defs/idSet"},
        "input_or_violation": {"$ref": "#/$defs/nonEmpty"},
        "expected_result": {"$ref": "#/$defs/nonEmpty"},
        "execution_owner": {"$ref": "#/$defs/id"},
        "execution_phase": {"enum": ["plan", "implementation", "validation"]},
        "evidence_state": {"const": "planned-contract"}
      }
    }
  }
}
