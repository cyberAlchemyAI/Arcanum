{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/define-profile-v2",
  "title": "Invoke Generic Definitions Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "public_contract", "historical_template_policy", "outputs"],
  "properties": {
    "schema_version": {"const": "invoke.define-profile.v2"},
    "profile_id": {"const": "invoke.generic-definitions-baseline.v2"},
    "public_contract": {"const": true},
    "historical_template_policy": {"const": "compatibility-read-only"},
    "outputs": {
      "type": "array",
      "const": [
        "spec",
        "definitions",
        "definitions-view",
        "glossary",
        "layering",
        "template-selection",
        "dispatch-trace",
        "distill",
        "identity-denominator",
        "transport",
        "stage-receipt"
      ]
    }
  }
}
