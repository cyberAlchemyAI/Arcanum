# Generated experiment evidence.
**/development/example-outputs/*
**/development/example-runs/*
**/development/runs/*

# Keep evidence directories present in reusable harnesses.
!**/development/example-outputs/.gitkeep
!**/development/example-runs/.gitkeep
!**/development/runs/.gitkeep

# Local Codex/Arcanum runtime state.
.arcanum/codex-home/
.arcanum/codex-home-smoke/
.arcanum/runtime/
tmp/

# Generated observability output. Keep the package skeleton and curated files
# force-added when durable evidence needs to be versioned.
.arcanum/observability/runs/*
.arcanum/observability/reflections/*
.arcanum/observability/by-sigil/*.jsonl
.arcanum/observability/by-capability/**/*.jsonl
.arcanum/observability/hooks/*.jsonl
.arcanum/observability/signals/*.jsonl
.arcanum/observability/reflection-state.json
!.arcanum/observability/runs/.gitkeep
!.arcanum/observability/reflections/.gitkeep
