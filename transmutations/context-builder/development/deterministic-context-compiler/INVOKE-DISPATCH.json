  "gates": [
    {
      "gate_id": "g-define",
      "kind": "quality",
      "owner": "invoke",
      "condition": "SPEC.md, GLOSSARY.md, SIGIL-HANDOFF.md, and DEFINE-TRANSPORT.md exist and preserve the evidence ceiling.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-design",
      "kind": "validation",
      "owner": "invoke",
      "condition": "The design denominator passes and the two selection passes have one fixed-point digest.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-plan",
      "kind": "quality",
      "owner": "invoke",
      "condition": "Layering, split tasks, atomic SWUs, exact closeout contracts, and validation mappings are complete.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-distill",
      "kind": "validation",
      "owner": "distill",
      "condition": "Narrowness, atomicity, deferred complexity, and recomposition checks pass.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-selection",
      "kind": "human_approval",
      "owner": "user-and-sigil-development",
      "condition": "Later mutation requires one explicit SWU selection after lifecycle acceptance; current selected_swu remains none.",
      "on_fail": "ask"
    },
    {
      "gate_id": "g-lifecycle",
      "kind": "promotion_guardrail",
      "owner": "sigil-development",
      "condition": "Invoke artifacts provide authoring evidence only; implementation receipts require lifecycle review and do not authorize registry release, publication, deployment, or production readiness.",
      "on_fail": "block"
    }
