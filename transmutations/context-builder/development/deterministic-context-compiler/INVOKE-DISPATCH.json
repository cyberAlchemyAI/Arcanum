{
  "$schema": "../../../../formulae/dispatch-spec/dispatch.schema.yml",
  "dispatch_id": "invoke-context-builder-deterministic-compiler-2026-07-27",
  "parent_dispatch_id": null,
  "intent": {
    "raw": "Define, design, and plan deterministic software that can persist and reuse Context Builder evidence while reducing prompt-context cost without weakening coverage or authority boundaries.",
    "objective": "Produce a validated Define, Design, and Plan package for a deterministic Context Builder compiler and route any later mutation to Sigil Development.",
