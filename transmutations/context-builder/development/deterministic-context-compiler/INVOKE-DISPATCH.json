    "arcanum_vocabulary": [
      "sigil",
      "transmutation",
      "context pack",
      "SWU",
      "lifecycle owner",
      "receipt"
    ],
    "operator_sentence": "Invoke defines the bounded compiler contract, selects the design extensions deterministically, plans serial evidence-backed SWUs, validates the plan through Distill, and hands lifecycle ownership to Sigil Development."
  },
  "mode": "sequence",
  "route_class": "native-capability-sequence",
  "techniques": [
