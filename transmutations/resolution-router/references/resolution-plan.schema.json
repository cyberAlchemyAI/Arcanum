{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/schemas/resolution-plan.schema.json",
  "title": "Resolution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "packet_digest",
    "requested_resolution",
    "selected_resolution",
    "reason",
    "guarantee_ids",
    "promotion",
    "lens_specific_allocation",
    "composed_finding_ids",
    "target_writer"
  ],
  "properties": {
    "plan_version": { "const": "2.0" },
    "packet_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requested_resolution": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "selected_resolution": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "guarantee_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[LMH][0-9]{2}-[a-z0-9-]+$" }
    },
    "promotion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "activating_guarantee_id", "reason"],
          "properties": {
            "from": { "type": "string", "enum": ["low", "medium"] },
            "to": { "type": "string", "enum": ["medium", "high"] },
            "activating_guarantee_id": {
              "type": "string",
              "pattern": "^[MH][0-9]{2}-[a-z0-9-]+$"
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "lens_specific_allocation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens", "emphasis", "finding_ids", "activated_guarantee_ids"],
        "properties": {
          "lens": {
            "type": "string",
            "enum": ["epistemic", "systemic", "categorical"]
          },
          "emphasis": { "type": "string", "minLength": 1 },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
          },
          "activated_guarantee_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[LMH][0-9]{2}-[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "composed_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
    },
    "target_writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "path", "status"],
      "properties": {
        "skill_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["available", "unavailable"] }
      }
    }
  }
}
