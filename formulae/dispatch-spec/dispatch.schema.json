{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/formulae/dispatch-spec/dispatch.schema.json",
  "title": "Arcanum Dispatch Spec",
  "description": "Draft schema for describing a governed Arcanum sigil/spell dispatch route.",
  "type": "object",
  "required": ["dispatch_id", "intent", "mode", "steps", "gates", "observability"],
  "properties": {
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_dispatch_id": {
      "type": ["string", "null"]
    },
    "intent": {
      "type": "object",
      "required": ["raw", "objective"],
      "properties": {
        "raw": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "target_artifact": {"type": "string"},
        "arcanum_vocabulary": {
          "type": "array",
          "items": {"type": "string"}
        },
        "operator_sentence": {"type": "string"}
      },
      "additionalProperties": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "sequence",
        "fanout",
        "dialectic",
        "tournament",
        "research",
        "validation",
        "spell-design",
        "implementation-research",
        "mixed"
      ]
    },
    "route_menu": {
      "type": "object",
      "description": "ChoiceCard-like bounded menu of possible routes or capabilities.",
      "properties": {
        "context_hint": {"type": "string"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": ["id", "label", "description"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "capability_ref": {"type": "string"},
              "pattern": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "selected_item_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "name", "capability_ref", "pattern", "inputs", "outputs"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "capability_ref": {"type": "string", "minLength": 1},
          "mode": {"type": "string"},
          "pattern": {
            "type": "string",
            "enum": [
              "route",
              "sequential",
              "fanout",
              "dialectic",
              "tournament",
              "distill",
              "xray",
              "decision",
              "validation",
              "toy_game",
              "synthesis",
              "handoff"
            ]
          },
          "parallel": {"type": "boolean"},
          "roles": {
            "type": "array",
            "items": {"type": "string"}
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["intent", "frame", "handle", "decision", "ledger", "human_answer", "external_context", "artifact"]
                },
                "ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["frame", "handle", "decision", "ledger", "artifact", "route_menu", "handoff", "trace_event"]
                },
                "ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "join_policy": {
            "type": "string",
            "enum": ["none", "all", "quorum", "ranked", "pareto", "parent_synthesis", "human_gate"]
          },
          "convergence_criteria": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_artifact": {"type": "string"},
          "stop_conditions": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "kind", "owner", "condition"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": ["policy", "decision", "quality", "promotion_guardrail", "validation", "human_approval"]
          },
          "owner": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "on_fail": {
            "type": "string",
            "enum": ["block", "flag", "defer", "ask", "reroute"]
          }
        },
        "additionalProperties": true
      }
    },
    "observability": {
      "type": "object",
      "required": ["trace_events"],
      "properties": {
        "dispatch_id_required": {"type": "boolean"},
        "parent_dispatch_id": {"type": ["string", "null"]},
        "trace_events": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "signal_grouping": {"type": "string"}
      },
      "additionalProperties": true
    },
    "promotion_guardrails": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}

