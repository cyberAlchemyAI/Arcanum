{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/schemas/action.schema.json",
  "title": "Native Dispatch Runner Spawn Action",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "action",
    "dispatch_id",
    "run_id",
    "wave_id",
    "step_id",
    "applies_to_steps",
    "role",
    "agent_ordinal",
    "agent_count",
    "capability_ref",
    "target",
    "mode",
    "mutation_policy",
    "write_scope",
    "forbidden_write_scopes",
    "input_refs",
    "output_refs"
  ],
  "properties": {
    "schema_version": {"const": "arcanum.native-dispatch-runner.action.v0.1"},
    "action_id": {"type": "string", "pattern": "^spawn-[0-9]{4}$"},
    "action": {"const": "spawn"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "applies_to_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "role": {"type": "string", "minLength": 1},
    "agent_ordinal": {"type": "integer", "minimum": 0},
    "agent_count": {"type": "integer", "minimum": 1},
    "capability_ref": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "mutation_policy": {"type": "string", "enum": ["read-only", "proposal-only", "lifecycle-owned", "artifact-only"]},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "forbidden_write_scopes": {"type": "array", "items": {"type": "string"}},
    "input_refs": {"type": "array", "items": {"type": "string"}},
    "output_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
