{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/schemas/gate-decision.schema.json",
  "title": "Native Dispatch Runner Gate Decision",
  "type": "object",
  "required": [
    "schema_version", "dispatch_id", "run_id", "wave_id", "gate_id", "decision",
    "required_action_ids", "admitted_receipt_action_ids", "next_wave_id", "next_action_ids", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "arcanum.native-dispatch-runner.gate-decision.v0.1"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": ["string", "null"]},
    "decision": {"enum": ["gate_pass", "gate_block"]},
    "required_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "admitted_receipt_action_ids": {"type": "array", "items": {"type": "string"}},
    "next_wave_id": {"type": ["string", "null"]},
    "next_action_ids": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
