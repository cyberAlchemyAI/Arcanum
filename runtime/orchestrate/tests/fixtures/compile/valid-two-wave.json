{
  "dispatch_id": "fixture-native-dispatch-two-wave",
  "intent": {
    "raw": "Compile the first wave of a deterministic two-wave fixture.",
    "objective": "Prove dependency filtering, declared role order, and agent cardinality."
  },
  "mode": "mixed",
  "techniques": ["sequence", "observability_grouping"],
  "subagent_strategy": {
    "status": "required",
    "trigger": "Two independent checks gate one dependent artifact role.",
    "explanation": "The parent owns ordered spawn, join, gate, and synthesis.",
    "binding_mode": "capability-bound",
    "execution_owner": "orchestrate",
    "roles": [
      {
        "role_id": "beta-check",
        "purpose": "Produce the beta check receipt.",
        "owns": "tmp/native-dispatch/receipts/beta.json",
        "capability_ref": "sigil-development",
        "capability_target": "beta-check",
        "capability_mode": "observe",
        "agent_count": 2,
        "mutation_policy": "lifecycle-owned",
        "write_scope": ["tmp/native-dispatch/receipts/beta.json"],
        "forbidden_write_scopes": ["arcana/"],
        "briefing_binding": {
          "contract_version": "arcanum.confirmed-role-briefing.v0.1",
          "source_binding": {"artifact_path": "confirmed-briefings.json", "artifact_sha256": "9d015d9f9211871dcefb4c4019f9cabd66596a50d52c139da01863824cac3b04", "selector": "/roles/beta-check", "selected_payload_sha256": "b75a2462502e327a853ef3fdd242b52937e9eeb3888dbd865cc4e112881db2b9"},
          "briefing": {
            "agent_identity": "Beta check verifier",
            "angle": "Test the beta evidence independently.",
            "instructions": "Read the declared beta input, write only the declared beta receipt, and report the bounded verification result.",
            "status_semantics": {"task_status_field": "task_status", "task_complete_value": "completed", "task_blocked_value": "blocked", "domain_gate_status_field": "domain_gate_status", "domain_gate_is_separate": true},
            "read_policy": {"input_refs": ["tmp/native-dispatch/inputs/beta.json"], "allowed_read_scopes": ["tmp/native-dispatch/inputs/"], "forbidden_read_scopes": [], "required_input_refs_readable": true},
            "write_policy": {"mutation_policy": "lifecycle-owned", "write_scope": ["tmp/native-dispatch/receipts/beta.json"], "forbidden_write_scopes": ["arcana/"]},
            "receipt_shape": {"required_fields": ["task_status", "domain_gate_status", "findings", "validation"], "completion_requires_all_fields": true},
            "authority_ceiling": {"summary": "Verify the beta input and own only the declared receipt.", "allowed_actions": ["read_declared_inputs", "write_declared_scope"], "forbidden_actions": ["promotion", "publication"]}
          },
          "briefing_sha256": "b75a2462502e327a853ef3fdd242b52937e9eeb3888dbd865cc4e112881db2b9"
        },
        "depends_on_roles": [],
        "input_refs": ["tmp/native-dispatch/inputs/beta.json"],
        "output_refs": ["tmp/native-dispatch/receipts/beta.json"],
        "applies_to_steps": ["s-beta"]
      },
      {
        "role_id": "alpha-check",
        "purpose": "Produce the alpha check receipt.",
        "owns": "tmp/native-dispatch/receipts/alpha.json",
        "capability_ref": "spellcraft",
        "capability_target": "alpha-check",
        "capability_mode": "reflect",
        "agent_count": 1,
        "mutation_policy": "lifecycle-owned",
        "write_scope": ["tmp/native-dispatch/receipts/alpha.json"],
        "forbidden_write_scopes": ["spells/"],
        "briefing_binding": {
          "contract_version": "arcanum.confirmed-role-briefing.v0.1",
          "source_binding": {"artifact_path": "confirmed-briefings.json", "artifact_sha256": "9d015d9f9211871dcefb4c4019f9cabd66596a50d52c139da01863824cac3b04", "selector": "/roles/alpha-check", "selected_payload_sha256": "6e9d0764d4543f7a88b6d745e01b29af73e349aaec44444ef1911bf70b986a16"},
          "briefing": {
            "agent_identity": "Alpha reflection verifier",
            "angle": "Reflect on the alpha evidence without borrowing beta conclusions.",
            "instructions": "Read the declared alpha input, write only the declared alpha receipt, and report the bounded reflection result.",
            "status_semantics": {"task_status_field": "task_status", "task_complete_value": "completed", "task_blocked_value": "blocked", "domain_gate_status_field": "domain_gate_status", "domain_gate_is_separate": true},
            "read_policy": {"input_refs": ["tmp/native-dispatch/inputs/alpha.json"], "allowed_read_scopes": ["tmp/native-dispatch/inputs/"], "forbidden_read_scopes": [], "required_input_refs_readable": true},
            "write_policy": {"mutation_policy": "lifecycle-owned", "write_scope": ["tmp/native-dispatch/receipts/alpha.json"], "forbidden_write_scopes": ["spells/"]},
            "receipt_shape": {"required_fields": ["task_status", "domain_gate_status", "findings", "validation"], "completion_requires_all_fields": true},
            "authority_ceiling": {"summary": "Reflect on the alpha input and own only the declared receipt.", "allowed_actions": ["read_declared_inputs", "write_declared_scope"], "forbidden_actions": ["promotion", "publication"]}
          },
          "briefing_sha256": "6e9d0764d4543f7a88b6d745e01b29af73e349aaec44444ef1911bf70b986a16"
        },
        "depends_on_roles": [],
        "input_refs": ["tmp/native-dispatch/inputs/alpha.json"],
        "output_refs": ["tmp/native-dispatch/receipts/alpha.json"],
        "applies_to_steps": ["s-alpha"]
      },
      {
        "role_id": "artifact-writer",
        "purpose": "Consume passing check receipts and write one artifact receipt.",
        "owns": "tmp/native-dispatch/receipts/artifact.json",
        "capability_ref": "task-session",
        "capability_target": "tmp/native-dispatch/artifact.json",
        "capability_mode": "execute",
        "agent_count": 1,
        "mutation_policy": "artifact-only",
        "write_scope": ["tmp/native-dispatch/artifact.json", "tmp/native-dispatch/receipts/artifact.json"],
        "forbidden_write_scopes": ["arcana/", "spells/"],
        "briefing_binding": {
          "contract_version": "arcanum.confirmed-role-briefing.v0.1",
          "source_binding": {"artifact_path": "confirmed-briefings.json", "artifact_sha256": "9d015d9f9211871dcefb4c4019f9cabd66596a50d52c139da01863824cac3b04", "selector": "/roles/artifact-writer", "selected_payload_sha256": "ebd5362d3e5e1176ce5b008ca278a7f037479ea37b99cc93a6e7b98756eb6f6c"},
          "briefing": {
            "agent_identity": "Dependent artifact writer",
            "angle": "Apply only conclusions proved by both upstream receipts.",
            "instructions": "Read both declared receipts and write only the declared artifact and artifact receipt after the upstream gate passes.",
            "status_semantics": {"task_status_field": "task_status", "task_complete_value": "completed", "task_blocked_value": "blocked", "domain_gate_status_field": "domain_gate_status", "domain_gate_is_separate": true},
            "read_policy": {"input_refs": ["tmp/native-dispatch/receipts/beta.json", "tmp/native-dispatch/receipts/alpha.json"], "allowed_read_scopes": ["tmp/native-dispatch/receipts/"], "forbidden_read_scopes": [], "required_input_refs_readable": true},
            "write_policy": {"mutation_policy": "artifact-only", "write_scope": ["tmp/native-dispatch/artifact.json", "tmp/native-dispatch/receipts/artifact.json"], "forbidden_write_scopes": ["arcana/", "spells/"]},
            "receipt_shape": {"required_fields": ["task_status", "domain_gate_status", "artifacts", "validation"], "completion_requires_all_fields": true},
            "authority_ceiling": {"summary": "Apply admitted receipts to the bounded artifact only.", "allowed_actions": ["read_declared_inputs", "write_declared_scope"], "forbidden_actions": ["promotion", "publication"]}
          },
          "briefing_sha256": "ebd5362d3e5e1176ce5b008ca278a7f037479ea37b99cc93a6e7b98756eb6f6c"
        },
        "depends_on_roles": ["beta-check", "alpha-check"],
        "input_refs": ["tmp/native-dispatch/receipts/beta.json", "tmp/native-dispatch/receipts/alpha.json"],
        "output_refs": ["tmp/native-dispatch/receipts/artifact.json"],
        "applies_to_steps": ["s-artifact"]
      }
    ],
    "execution_waves": [
      {
        "wave_id": "checks",
        "role_ids": ["beta-check", "alpha-check"],
        "parallel": true,
        "join_policy": "all",
        "gate_after": "g-checks",
        "on_incomplete": "block"
      },
      {
        "wave_id": "artifact",
        "role_ids": ["artifact-writer"],
        "parallel": false,
        "join_policy": "all",
        "depends_on_waves": ["checks"],
        "on_incomplete": "block"
      }
    ],
    "parallelism": "mixed",
    "join_policy": "parent_synthesis",
    "authorization": "approved",
    "permission_prompt": "Run the deterministic compile fixture?",
    "receipt_requirements": [
      "agent_id",
      "role_id",
      "spawn_status",
      "join_status",
      "close_status",
      "dispatch_id",
      "step_id",
      "capability_ref",
      "capability_target",
      "capability_mode",
      "wave_id",
      "write_scope",
      "status",
      "artifacts",
      "validation",
      "observer_status",
      "blockers",
      "residue",
      "reroute",
      "handoff_note"
    ]
  },
  "subagent_lifecycle": {"status": "none", "agents": []},
  "steps": [
    {
      "step_id": "s-beta",
      "name": "Run beta check",
      "capability_ref": "sigil-development",
      "mode": "observe",
      "pattern": "sequential",
      "parallel": true,
      "inputs": [{"kind": "external_context", "ref": "tmp/native-dispatch/inputs/beta.json"}],
      "outputs": [{"kind": "receipt", "ref": "tmp/native-dispatch/receipts/beta.json"}],
      "join_policy": "all",
      "stop_conditions": ["stop when beta input is invalid"]
    },
    {
      "step_id": "s-alpha",
      "name": "Run alpha check",
      "capability_ref": "spellcraft",
      "mode": "reflect",
      "pattern": "sequential",
      "parallel": true,
      "inputs": [{"kind": "external_context", "ref": "tmp/native-dispatch/inputs/alpha.json"}],
      "outputs": [{"kind": "receipt", "ref": "tmp/native-dispatch/receipts/alpha.json"}],
      "join_policy": "all",
      "stop_conditions": ["stop when alpha input is invalid"]
    },
    {
      "step_id": "s-artifact",
      "name": "Write dependent artifact",
      "capability_ref": "task-session",
      "mode": "execute",
      "pattern": "sequential",
      "parallel": false,
      "depends_on_steps": ["s-beta", "s-alpha"],
      "techniques": ["sequence", "observability_grouping"],
      "inputs": [
        {"kind": "receipt", "ref": "tmp/native-dispatch/receipts/beta.json"},
        {"kind": "receipt", "ref": "tmp/native-dispatch/receipts/alpha.json"}
      ],
      "outputs": [{"kind": "receipt", "ref": "tmp/native-dispatch/receipts/artifact.json"}],
      "stop_conditions": ["stop unless both receipts pass"]
    }
  ],
  "gates": [
    {
      "gate_id": "g-checks",
      "kind": "validation",
      "owner": "orchestrate",
      "condition": "Both check receipts pass before the artifact wave starts.",
      "applies_after_wave": "checks",
      "requires_role_receipts": ["tmp/native-dispatch/receipts/beta.json", "tmp/native-dispatch/receipts/alpha.json"],
      "on_fail": "block"
    }
  ],
  "native_stage_receipts": [],
  "observability": {
    "dispatch_id_required": true,
    "trace_events": ["dispatch_validated", "first_wave_compiled"],
    "signal_grouping": "dispatch_id and run_id"
  },
  "promotion_guardrails": ["Fixture execution evidence grants no lifecycle authority."]
}
