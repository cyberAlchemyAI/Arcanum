{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/tests/native-spawn/native-spawn-event.schema.json",
  "title": "Native Spawn Event",
  "type": "object",
  "required": ["sequence", "timestamp", "event", "dispatch_id", "run_id", "action_id", "operation"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "event": {"enum": ["action_attempted", "host_spawn_returned", "host_spawn_failed", "proof_helper_joined"]},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "pattern": "^spawn-[0-9]{4}$"},
    "operation": {"const": "collaboration.spawn_agent"},
    "role": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"enum": ["host_spawn_returned", "proof_helper_joined"]}}},
      "then": {"required": ["agent_id"]}
    },
    {
      "if": {"properties": {"event": {"const": "host_spawn_failed"}}},
      "then": {"required": ["error"]}
    }
  ],
  "additionalProperties": false
}
