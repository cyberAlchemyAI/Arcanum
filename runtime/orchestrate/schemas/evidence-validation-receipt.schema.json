{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/schemas/evidence-validation-receipt.schema.json",
  "title": "Native Dispatch Runner Evidence Validation Receipt",
  "type": "object",
  "required": ["schema_version", "validator", "source", "event_count", "valid", "status", "errors"],
  "properties": {
    "schema_version": {"const": "arcanum.native-dispatch-runner.evidence-validation.v0.1"},
    "validator": {"const": "validate_run_evidence.py"},
    "source": {"type": "string", "minLength": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "valid": {"type": "boolean"},
    "status": {"enum": ["pass", "block"]},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "sequence", "action_id", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "sequence": {"type": ["integer", "null"], "minimum": 1},
          "action_id": {"type": ["string", "null"]},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"valid": {"const": true}}}, "then": {"properties": {"status": {"const": "pass"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"valid": {"const": false}}}, "then": {"properties": {"status": {"const": "block"}, "errors": {"minItems": 1}}}}
  ],
  "additionalProperties": false
}
