{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/runtime/orchestrate/schemas/state.schema.json",
  "title": "Native Dispatch Runner State",
  "type": "object",
  "required": [
    "schema_version",
    "dispatch_id",
    "run_id",
    "state",
    "validation_status",
    "authorization_status",
    "selected_wave_id",
    "eligible_action_ids",
    "completed_wave_ids",
    "blockers"
  ],
  "properties": {
    "schema_version": {"enum": ["arcanum.native-dispatch-runner.state.v0.1", "arcanum.native-dispatch-runner.state.v0.2"]},
    "dispatch_id": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["prepared", "authorization_pending", "ready", "wave_ready", "wave_running", "wave_joined", "gate_pass", "gate_block", "blocked", "complete"]},
    "validation_status": {"enum": ["pass", "flag", "block"]},
    "authorization_status": {"type": "string"},
    "selected_wave_id": {"type": ["string", "null"]},
    "eligible_action_ids": {"type": "array", "items": {"type": "string"}},
    "completed_wave_ids": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "terminal_outcome": {
      "type": ["object", "null"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "source_field": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "classification": {"enum": ["pass", "resolved"]}
      },
      "required": ["gate_id", "role_id", "source_field", "value", "classification"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "arcanum.native-dispatch-runner.state.v0.2"}}},
      "then": {"required": ["terminal_outcome"]},
      "else": {"not": {"required": ["terminal_outcome"]}}
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "arcanum.native-dispatch-runner.state.v0.2"},
          "state": {"not": {"const": "complete"}}
        }
      },
      "then": {"properties": {"terminal_outcome": {"type": "null"}}}
    }
  ],
  "additionalProperties": false
}
