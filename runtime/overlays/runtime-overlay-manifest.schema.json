{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/schemas/runtime-overlay-manifest.v1.json",
  "title": "Arcanum Runtime Overlay Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "canonical",
    "generator",
    "payload_root",
    "runtime_targets",
    "allowed_metadata",
    "fragments",
    "presets",
    "protected_controls",
    "validation_command"
  ],
  "properties": {
    "schema_version": {
      "const": "arcanum.runtime-overlay-manifest.v1"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "canonical": {
      "$ref": "#/$defs/canonical"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "payload_root": {
      "$ref": "#/$defs/relativePath"
    },
    "runtime_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runtimeTarget"
      }
    },
    "allowed_metadata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fragment"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preset"
      }
    },
    "protected_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/protectedControl"
      }
    },
    "validation_command": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:[\\\\/])"
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256",
        "package_root"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_root": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "version_marker",
        "overlay_protocol"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "version_marker": {
          "type": "string",
          "minLength": 1
        },
        "overlay_protocol": {
          "const": "arcanum.runtime-overlay-manifest.v1"
        }
      }
    },
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package_root",
        "skill_path",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "package_root": {
          "$ref": "#/$defs/relativePath"
        },
        "skill_path": {
          "$ref": "#/$defs/relativePath"
        },
        "metadata": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "preset_ids",
        "source",
        "sha256",
        "mode",
        "anchor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "preset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "const": "insert_after_exact"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "copiedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "sha256"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_dir",
        "copied_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_dir": {
          "$ref": "#/$defs/relativePath"
        },
        "copied_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/copiedFile"
          }
        }
      }
    },
    "protectedControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "class": {
          "enum": [
            "gate",
            "status",
            "authority",
            "state"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
