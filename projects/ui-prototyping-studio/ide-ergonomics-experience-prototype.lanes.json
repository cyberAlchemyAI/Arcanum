{
  "xray_version": "0.2.0",
  "example_id": "ide-ergonomics-experience-prototype",
  "mode": "interactive-prototype",
  "target_boundary": "projects/ui-prototyping-studio/ide-ergonomics-experience-prototype.html",
  "reader_contract": {
    "reader_baseline": "person evaluating the IDE Ergonomics product idea",
    "target_public": "local private prototype",
    "reader_reward": "Experience the product as a click-through IDE flow instead of reading an architecture deck.",
    "opening_contract": {
      "must_start_with": [
        "a live chat moment",
        "a highlighted phrase",
        "a click-triggered route card"
      ],
      "must_not_start_with": [
        "coordinate model",
        "primitive federation",
        "raw governance taxonomy"
      ]
    }
  },
  "prototype_flow": [
    {
      "step": 1,
      "surface": "chat.hotphrase.evidence-rail",
      "user_action": "click highlighted phrase",
      "visible_result": "workflow transition card appears"
    },
    {
      "step": 2,
      "surface": "route.choice.candidate",
      "user_action": "create definition candidate",
      "visible_result": "candidate packet modal appears and can be saved"
    },
    {
      "step": 3,
      "surface": "route.choice.side-node",
      "user_action": "save tangent",
      "visible_result": "side node artifact appears in durable output rail"
    },
    {
      "step": 4,
      "surface": "route.choice.handoff",
      "user_action": "prepare handoff",
      "visible_result": "handoff draft with restart prompt and source refs appears"
    },
    {
      "step": 5,
      "surface": "route.choice.delegation",
      "user_action": "preview delegation",
      "visible_result": "role cards and receipt expectations appear without spawning agents"
    },
    {
      "step": 6,
      "surface": "final.workbench",
      "user_action": "show workbench",
      "visible_result": "candidate, side node, handoff, and gated delegation appear as durable session outputs"
    }
  ],
  "stable_component_ids": [
    "prototype.root",
    "prototype.topbar",
    "workspace.layout",
    "scenario.rail",
    "workspace.center",
    "chat.shell",
    "chat.hotphrase.evidence-rail",
    "popover.route-card",
    "route.choice.candidate",
    "route.choice.side-node",
    "route.choice.handoff",
    "route.choice.delegation",
    "modal.dialog",
    "artifact.rail",
    "artifact.candidate",
    "artifact.side-node",
    "artifact.handoff",
    "artifact.delegation",
    "final.workbench"
  ],
  "governance_boundary": {
    "prototype_claims": [
      "shows the intended interaction sequence",
      "shows what artifacts could appear for an end user",
      "is suitable for screenshot review and annotation"
    ],
    "not_claimed": [
      "does not prove human understanding",
      "does not promote IDE Ergonomics specs",
      "does not mutate Arcanum capabilities",
      "does not spawn agents or execute owner routes"
    ]
  }
}
