{
  "name": "@ui-prototyping-studio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "studio": "tsx src/cli/studio.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:skill": "bash ../development/operating-skill-harness/run-validation-fixtures.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
