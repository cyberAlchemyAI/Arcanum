{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/distill-execution-receipt/1-0-0",
  "title": "DistillExecutionReceipt",
  "description": "Non-authoritative structural projection of reported Distill evidence. Validation requires separately resolving every reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "request_ref",
    "event_refs",
    "role_trace",
    "objections",
    "reconciliations",
    "technique_trace",
    "termination",
    "verdict",
    "gaps",
    "recomposition",
    "next_route",
    "reviewed_input_provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "request_ref": { "$ref": "#/$defs/exactArtifactRef" },
    "event_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "role_trace": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/roleTraceEntry" }
    },
    "objections": { "type": "array", "items": { "$ref": "#/$defs/evidenceStatement" } },
    "reconciliations": { "type": "array", "items": { "$ref": "#/$defs/evidenceStatement" } },
    "technique_trace": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/techniqueTraceEntry" }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "round_count"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "round_count": { "type": "integer", "minimum": 1 }
      }
    },
    "verdict": { "enum": ["pass", "flag", "block"] },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "recomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "result_ref"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "result_ref": { "$ref": "#/$defs/exactArtifactRef" }
      }
    },
    "next_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "status"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ready", "blocked"] }
      }
    },
    "reviewed_input_provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exactArtifactRef" }
    }
  },
  "$defs": {
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "roleTraceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "execution_path", "evidence_refs", "result_ref"],
      "properties": {
        "role": { "enum": ["proposer", "balancer"] },
        "execution_path": { "enum": ["true_subagent", "role_simulation"] },
        "invocation_ref": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result_ref": { "$ref": "#/$defs/exactArtifactRef" }
      }
    },
    "evidenceStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_refs"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "objection_id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["authority", "coverage", "process", "provenance", "role", "scope", "technique", "other"]
        },
        "objection_ref": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["accept", "revise", "reject", "defer", "route"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "techniqueTraceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technique", "status", "evidence_refs"],
      "properties": {
        "technique": { "type": "string", "minLength": 1 },
        "status": { "enum": ["applied", "not_applicable", "failed"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
