{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/work-pack-readiness-audit/refresh-signal-pack/1-0-0",
  "title": "WorkPackReadinessRefreshSignalPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "source_report",
    "mutation_mode",
    "mutation_ready",
    "authority_effect",
    "signals",
    "target_inventory",
    "next_owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "minLength": 1},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"const": "work-pack-readiness-report.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "mutation_mode": {"const": "proposal-only"},
    "mutation_ready": {"const": false},
    "authority_effect": {"const": "none"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "signal_type",
          "claim",
          "evidence",
          "target_artifacts",
          "confidence",
          "mutation_safety"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "signal_type": {
            "enum": [
              "evidence_added",
              "blocker_opened",
              "artifact_drift",
              "no_op"
            ]
          },
          "claim": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "target_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "mutation_safety": {"enum": ["safe", "needs_review", "blocked"]}
        }
      }
    },
    "target_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "next_owner": {"const": "invoke:refresh"}
  }
}
