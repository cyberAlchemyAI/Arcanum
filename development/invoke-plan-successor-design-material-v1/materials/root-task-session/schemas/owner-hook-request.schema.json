{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/owner-hook-request/1-0-0",
  "title": "TaskSessionOwnerHookRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "adapter_id",
    "phase",
    "owner_identity",
    "manifest_ref",
    "request_schema_ref",
    "receipt_schema_ref",
    "input_refs",
    "allowed_output_paths",
    "expected_receipt_path",
    "timeout_seconds",
    "max_output_bytes",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "task-session.owner-hook-request.v1"
    },
    "request_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "adapter_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "phase": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "owner_identity": {
      "$ref": "#/$defs/ownerIdentity"
    },
    "manifest_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "request_schema_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "receipt_schema_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exactArtifactRef"
      }
    },
    "allowed_output_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "expected_receipt_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 1048576
    },
    "idempotency_key": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "ownerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "subject"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subject": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
