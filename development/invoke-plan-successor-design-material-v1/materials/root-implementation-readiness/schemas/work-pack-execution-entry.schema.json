{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/implementation-readiness/work-pack-execution-entry/1-0-0",
  "title": "InvokeAuthoredWorkPackExecutionEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_pack_id",
    "admission_timing",
    "frontier",
    "execution_policy",
    "execution_entry",
    "pre_execution_owner_prerequisite",
    "continuation_rule",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "arcanum.work-pack-execution-entry/v1"},
    "work_pack_id": {"type": "string", "minLength": 1},
    "admission_timing": {
      "enum": ["full-frontier", "selected-unit-at-task-session"]
    },
    "frontier": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "execution_policy": {"$ref": "#/$defs/executionPolicy"},
    "execution_entry": {"$ref": "#/$defs/executionEntry"},
    "pre_execution_owner_prerequisite": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "minProperties": 1}
      ]
    },
    "continuation_rule": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "frontier_swu",
        "capability",
        "mode",
        "target",
        "write_scope",
        "effect_class",
        "required_inputs",
        "expected_receipt"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "frontier_swu": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "effect_class": {"const": "repository-local-reversible"},
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_receipt": {"type": "string", "minLength": 1}
      }
    },
    "declaredRetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "only_after", "same_route_and_binding"],
      "properties": {
        "max": {"const": 1},
        "only_after": {"const": "REPAIRABLE_OWNER_CONDITION"},
        "same_route_and_binding": {"const": true}
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_policy",
        "allowed_routes",
        "allowed_routes_digest",
        "digest_algorithm",
        "automatic_decisions",
        "stop_decisions",
        "scope_source",
        "validation_policy"
      ],
      "properties": {
        "route_policy": {"const": "automatic-in-scope"},
        "allowed_routes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/allowedRoute"}
        },
        "allowed_routes_digest": {"$ref": "#/$defs/sha256"},
        "digest_algorithm": {
          "const": "sha256 of RFC8785-compatible canonical JSON for allowed_routes"
        },
        "automatic_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "internal-tool-selection",
              "capability-owner-routing",
              "reversible-local-default",
              "declared-fallback",
              "declared-retry",
              "fresh-task-session-resumption"
            ]
          }
        },
        "stop_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "product-or-semantic-choice",
              "scope-expansion",
              "destructive-or-irreversible-effect",
              "credentials-or-secret-access",
              "external-message-or-network-effect",
              "cost-policy-or-risk-acceptance",
              "authority-promotion-publication-deployment",
              "failed-acceptance-critical-validation"
            ]
          }
        },
        "scope_source": {"const": "exact-work-pack-and-captured-frontier"},
        "validation_policy": {"const": "owner-gates-remain-mandatory"},
        "declared_retry": {"$ref": "#/$defs/declaredRetry"}
      }
    },
    "executionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "selected_unit", "route_id", "next_owner"],
      "properties": {
        "state": {
          "enum": ["selection-ready", "owner-prerequisite", "task-ready", "blocked"]
        },
        "selected_unit": {"type": ["string", "null"], "minLength": 1},
        "route_id": {"type": ["string", "null"], "minLength": 1},
        "next_owner": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
