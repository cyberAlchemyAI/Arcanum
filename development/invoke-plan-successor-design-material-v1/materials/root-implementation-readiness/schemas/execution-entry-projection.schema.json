{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/implementation-readiness/execution-entry-projection/1-0-0",
  "title": "ExecutionEntryProjection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_pack_id",
    "work_pack_semantic_digest",
    "allowed_routes_digest",
    "entry_state",
    "selected_unit",
    "route_id",
    "next_owner",
    "blocker_code",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "work_pack_id": {"type": "string", "minLength": 1},
    "work_pack_semantic_digest": {"$ref": "#/$defs/sha256"},
    "allowed_routes_digest": {"$ref": "#/$defs/sha256"},
    "entry_state": {
      "enum": ["selection-ready", "owner-prerequisite", "context-ready", "task-ready", "blocked"]
    },
    "selected_unit": {"type": ["string", "null"], "minLength": 1},
    "route_id": {"type": ["string", "null"], "minLength": 1},
    "next_owner": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "mode", "target"],
          "properties": {
            "capability": {"type": "string", "minLength": 1},
            "mode": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "blocker_code": {"type": ["string", "null"], "minLength": 1},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
