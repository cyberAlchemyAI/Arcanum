{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/executor-receipt/1-0-0",
  "title": "TaskSessionExecutorReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "task_id",
    "swu_id",
    "ticket_ref",
    "owner_identity",
    "idempotency_key",
    "result",
    "touched_files",
    "outputs",
    "validation_results",
    "bounded_capture",
    "terminal_sequence",
    "residue"
  ],
  "properties": {
    "schema_version": {
      "const": "task-session.executor-receipt.v1"
    },
    "receipt_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "task_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "swu_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "ticket_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "owner_identity": {
      "$ref": "#/$defs/ownerIdentity"
    },
    "idempotency_key": {
      "$ref": "#/$defs/idempotencyKey"
    },
    "result": {
      "enum": [
        "pass",
        "block",
        "interrupted"
      ]
    },
    "touched_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exactArtifactRef"
      }
    },
    "transient_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/transientResult"
      }
    },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationResult"
      }
    },
    "bounded_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_output_bytes",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_truncated",
        "stderr_truncated"
      ],
      "properties": {
        "max_output_bytes": {
          "$ref": "#/$defs/maxOutputBytes"
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        }
      }
    },
    "terminal_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_number",
        "receipt_path",
        "final_executor_write"
      ],
      "properties": {
        "sequence_number": {
          "type": "integer",
          "minimum": 1
        },
        "receipt_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "final_executor_write": {
          "const": true
        }
      }
    },
    "residue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "transientResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "path_kind",
        "touched",
        "cleanup_attempted",
        "cleanup_result",
        "terminal_state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path_kind": {
          "enum": ["directory", "file"]
        },
        "touched": {
          "const": true
        },
        "cleanup_attempted": {
          "const": true
        },
        "cleanup_result": {
          "const": "removed"
        },
        "terminal_state": {
          "const": "absent"
        }
      }
    },
    "ownerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "subject"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subject": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "argv",
        "cwd",
        "timeout_seconds",
        "max_output_bytes",
        "exit_code",
        "result"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "cwd": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_output_bytes": {
          "$ref": "#/$defs/maxOutputBytes"
        },
        "exit_code": {
          "type": "integer"
        },
        "result": {
          "enum": [
            "pass",
            "flag",
            "block"
          ]
        }
      }
    }
  }
}
