{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/live-execution-entry-preparation-receipt/1-0-0",
  "title": "TaskSessionLiveExecutionEntryPreparationReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "attempt_id", "request_ref", "owner_acceptance_request_ref", "owner_acceptance_response_ref", "authority_write_ceiling_digest", "partition_ref", "step_outputs", "effect", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "task-session.live-execution-entry-preparation-receipt.v1"},
    "result": {"const": "pass"},
    "attempt_id": {"type": "string", "minLength": 1},
    "request_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "owner_acceptance_request_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "owner_acceptance_response_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "authority_write_ceiling_digest": {"$ref": "#/$defs/sha256"},
    "partition_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "step_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/exactArtifactRef"}},
    "effect": {"const": "accepted-control-preparation-only"},
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactArtifactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}
  }
}
