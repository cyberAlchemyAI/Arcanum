{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/fast-entry-route-scope-partition/1-0-0",
  "title": "TaskSessionFastEntryRouteScopePartitionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executor_write_scopes",
    "lifecycle_owner_scopes",
    "terminal_receipt_scope",
    "exact_union_scope"
  ],
  "properties": {
    "schema_version": {"const": "task-session.fast-entry-route-scope-partition.v1"},
    "executor_write_scopes": {"$ref": "#/$defs/pathSet"},
    "lifecycle_owner_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner_capability", "write_class"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "owner_capability": {"type": "string", "minLength": 1},
          "write_class": {"type": "string", "minLength": 1}
        }
      }
    },
    "terminal_receipt_scope": {"$ref": "#/$defs/path"},
    "control_evidence_partition": {
      "type": "object"
    },
    "exact_union_scope": {"$ref": "#/$defs/pathSet"}
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    },
    "pathSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    }
  }
}
