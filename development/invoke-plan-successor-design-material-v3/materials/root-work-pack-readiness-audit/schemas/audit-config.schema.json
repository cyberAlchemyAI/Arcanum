{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/work-pack-readiness-audit/config/1-0-0",
  "title": "WorkPackReadinessAuditConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "repository_root",
    "authority_class",
    "publication_class",
    "work_pack",
    "control_artifacts",
    "task_session_request_schema",
    "terminal_receipt_schema",
    "units",
    "immutable_paths",
    "shared_write_owners",
    "source_selectors",
    "closeout_directory",
    "refresh_targets",
    "next_owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "minLength": 1},
    "repository_root": {"const": "."},
    "authority_class": {"enum": ["public", "private"]},
    "publication_class": {"enum": ["public", "private", "internal"]},
    "work_pack": {"$ref": "#/$defs/exactArtifactRef"},
    "control_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/exactArtifactRef"}
    },
    "task_session_request_schema": {"$ref": "#/$defs/exactArtifactRef"},
    "terminal_receipt_schema": {"$ref": "#/$defs/exactArtifactRef"},
    "terminal_receipt_semantic_validator": {
      "oneOf": [
        {"$ref": "#/$defs/exactArtifactRef"},
        {"type": "null"}
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "immutable_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "shared_write_owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "ordered_units"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "ordered_units": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "source_selectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "closeout_directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "create_if_missing"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "create_if_missing": {"type": "boolean"}
      }
    },
    "handoff_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "expected_fields"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/exactArtifactRef"},
        "expected_fields": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "refresh_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "next_owner": {"const": "invoke:refresh"}
  },
  "$defs": {
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "argv",
        "expected_exit_code",
        "timeout_seconds",
        "environment",
        "runtime_identity",
        "risk_class"
      ],
      "properties": {
        "cwd": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_exit_code": {"type": "integer"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "version_policy", "hash_policy"],
          "properties": {
            "executable": {"type": "string", "minLength": 1},
            "version_policy": {"type": "string", "minLength": 1},
            "hash_policy": {"type": "string", "minLength": 1}
          }
        },
        "risk_class": {
          "enum": [
            "read-only",
            "bounded-write",
            "browser",
            "network",
            "destructive"
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "id_algorithm",
        "collision_policy",
        "retention_policy",
        "teardown_on_success",
        "teardown_on_failure"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "id_algorithm": {"type": "string"},
        "collision_policy": {"enum": ["fail-if-exists", "append-only"]},
        "retention_policy": {"enum": ["retain-receipt-only", "retain-all", "ephemeral"]},
        "teardown_on_success": {
          "type": "array",
          "items": {"$ref": "#/$defs/command"}
        },
        "teardown_on_failure": {
          "type": "array",
          "items": {"$ref": "#/$defs/command"}
        }
      }
    },
    "dependencyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "receipt_ref",
        "expected_unit_id",
        "expected_step_id",
        "expected_status",
        "work_pack_sha256"
      ],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "receipt_ref": {"$ref": "#/$defs/exactArtifactRef"},
        "expected_unit_id": {"type": "string", "minLength": 1},
        "expected_step_id": {"type": "string", "minLength": 1},
        "expected_status": {"const": "pass"},
        "work_pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "task_class",
        "state",
        "requested_execution_mode",
        "contract_kind",
        "contract_ref",
        "dependencies",
        "dependency_receipts",
        "successor",
        "dispatch_step",
        "material_writes",
        "execution_outputs",
        "allowed_writes",
        "validation_commands",
        "attempt",
        "terminal_receipt",
        "closeout_receipt"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "task_class": {
          "enum": [
            "material-mutation",
            "output-only",
            "audit-only",
            "read-only-validation"
          ]
        },
        "state": {"enum": ["planned", "complete", "blocked"]},
        "requested_execution_mode": {
          "enum": [
            "routed-mutation",
            "reusable-mutation",
            "standalone-nonmutating"
          ]
        },
        "contract_kind": {"enum": ["full-task", "row-only"]},
        "contract_ref": {"$ref": "#/$defs/exactArtifactRef"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dependency_receipts": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependencyReceipt"}
        },
        "successor": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "dispatch_step": {"type": "string", "minLength": 1},
        "material_writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "execution_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "validation_commands": {
          "type": "array",
          "items": {"$ref": "#/$defs/command"}
        },
        "attempt": {"$ref": "#/$defs/attempt"},
        "material_package": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["package_ref", "receipt_ref"],
              "properties": {
                "package_ref": {"$ref": "#/$defs/exactArtifactRef"},
                "receipt_ref": {"$ref": "#/$defs/exactArtifactRef"}
              }
            },
            {"type": "null"}
          ]
        },
        "terminal_receipt": {"type": "string", "minLength": 1},
        "closeout_receipt": {"type": "string", "minLength": 1}
      }
    }
  }
}
