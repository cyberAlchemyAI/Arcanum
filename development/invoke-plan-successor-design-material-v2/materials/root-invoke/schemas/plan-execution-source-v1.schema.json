{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/plan-execution-source/v1",
  "title": "InvokePlanExecutionSourceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "work_pack", "requested_effect", "route_contracts", "wpra_config"],
  "properties": {
    "schema_version": {"const": "invoke.plan-execution-source.v1"},
    "source_id": {"type": "string", "minLength": 1},
    "work_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_pack_id", "title", "objective", "execution_designation"],
      "properties": {
        "work_pack_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "execution_designation": {"const": "execution-candidate"}
      }
    },
    "requested_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_class", "external_effect", "publication", "deployment"],
      "properties": {
        "effect_class": {"const": "repository-local-reversible"},
        "external_effect": {"const": "none"},
        "publication": {"const": "forbidden"},
        "deployment": {"const": "forbidden"}
      }
    },
    "route_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "frontier_swu", "capability", "mode", "target", "write_scope", "effect_class", "required_inputs", "expected_receipt"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "frontier_swu": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "write_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "effect_class": {"const": "repository-local-reversible"},
          "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "expected_receipt": {"type": "string", "minLength": 1}
        }
      }
    },
    "wpra_config": {"type": "object"}
  }
}
