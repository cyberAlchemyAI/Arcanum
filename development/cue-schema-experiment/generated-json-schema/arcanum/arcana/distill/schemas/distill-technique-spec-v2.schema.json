{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "activation": {
            "enum": [
                "always",
                "condition",
                "mode_required",
                "risk_required",
                "user_requested"
            ]
        },
        "allowed_inputs": {
            "allOf": [
                {
                    "prefixItems": [
                        true
                    ]
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                }
            ]
        },
        "block_condition": {
            "type": "string",
            "minLength": 1
        },
        "display_name": {
            "type": "string",
            "minLength": 1
        },
        "emits": {
            "allOf": [
                {
                    "prefixItems": [
                        true
                    ]
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                }
            ]
        },
        "emitted_field_constraints": {
            "allOf": [
                {
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "const_value": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "value_kind": {
                                        "const": "const"
                                    }
                                },
                                "required": [
                                    "const_value",
                                    "value_kind"
                                ]
                            },
                            {
                                "const": {
                                    "definition_ref": "https://arcanum.dev/schemas/distill/common/2-0-0#/$defs/canonical_identifier",
                                    "value_kind": "canonical_identifier"
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "value_kind": {
                                        "const": "enum"
                                    },
                                    "values": {
                                        "allOf": [
                                            {
                                                "prefixItems": [
                                                    true
                                                ]
                                            },
                                            {
                                                "type": "array",
                                                "items": {
                                                    "type": "string",
                                                    "minLength": 1
                                                },
                                                "minItems": 1,
                                                "uniqueItems": true
                                            }
                                        ]
                                    }
                                },
                                "required": [
                                    "value_kind",
                                    "values"
                                ]
                            },
                            {
                                "const": {
                                    "definition_ref": "https://arcanum.dev/schemas/distill/common/2-0-0#/$defs/non_empty_string",
                                    "value_kind": "non_empty_string"
                                }
                            },
                            {
                                "const": {
                                    "value_kind": "boolean"
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": true
                }
            ]
        },
        "failure_behavior": {
            "enum": [
                "pass",
                "flag",
                "block",
                "skip_with_reason",
                "route"
            ]
        },
        "flag_condition": {
            "type": "string",
            "minLength": 1
        },
        "hooks": {
            "allOf": [
                {
                    "prefixItems": [
                        true
                    ]
                },
                {
                    "items": {
                        "enum": [
                            "after_intent_confirmation",
                            "before_layer_split",
                            "after_proposer_pass",
                            "after_balancer_pass",
                            "before_accept_split",
                            "before_pitch_off",
                            "before_verdict",
                            "after_verdict"
                        ]
                    }
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                }
            ]
        },
        "pass_condition": {
            "type": "string",
            "minLength": 1
        },
        "phases": {
            "allOf": [
                {
                    "prefixItems": [
                        true
                    ]
                },
                {
                    "items": {
                        "enum": [
                            "setup",
                            "concept_mapping",
                            "proposal",
                            "balance",
                            "closure",
                            "pitch_off",
                            "final_synthesis",
                            "handoff"
                        ]
                    }
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                }
            ]
        },
        "schema_version": {
            "const": "distill.technique_spec.v2"
        },
        "technique_id": {
            "type": "string"
        },
        "type": {
            "enum": [
                "gate",
                "lens",
                "classifier",
                "mode_mechanic",
                "check",
                "closeout"
            ]
        }
    },
    "required": [
        "activation",
        "allowed_inputs",
        "block_condition",
        "display_name",
        "emits",
        "emitted_field_constraints",
        "failure_behavior",
        "flag_condition",
        "hooks",
        "pass_condition",
        "phases",
        "schema_version",
        "technique_id",
        "type"
    ]
}
