                                                "pointer": {
                                                    "type": "string",
                                                    "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
                                                },
                                                "value": true
                                            },
                                            "required": [
                                                "pointer",
                                                "value"
                                            ]
                                        }
