                                                            },
                                                            "uniqueItems": true
                                                        }
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "pointer",
                                                "projection"
                                            ]
                                        }
                                    },
                                    "derived_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "pointer": {
                                                    "type": "string",
                                                    "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
                                                },
                                                "prefix": {
                                                    "type": "string",
                                                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                                                }
                                            },
                                            "required": [
                                                "pointer",
                                                "prefix"
                                            ]
                                        }
                                    },
                                    "description": {
                                        "type": "string",
                                        "pattern": ".*\\S.*"
