                                    "runner": {
                                        "anyOf": [
                                            {
                                                "type": "null"
                                            },
                                            {
                                                "type": "string"
                                            }
                                        ]
                                    }
                                },
                                "required": [
                                    "derived_digests",
                                    "derived_ids",
                                    "description",
                                    "fixed_fields",
