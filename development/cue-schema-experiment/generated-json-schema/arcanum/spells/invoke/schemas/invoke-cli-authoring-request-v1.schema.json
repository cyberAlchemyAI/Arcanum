{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "AbsURL": {
            "type": "string"
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "$ref": "#/$defs/AbsURL"
        },
        "document": {
            "const": {}
        },
        "evidence_paths": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "kind": {
                        "enum": [
                            "file",
                            "directory"
                        ]
                    },
                    "path": {
                        "type": "string"
                    },
                    "pointer": {
                        "type": "string",
                        "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
                    }
                },
                "required": [
                    "path",
                    "pointer"
                ]
            },
            "uniqueItems": true
        },
        "mode": {
            "enum": [
                "define",
                "design"
            ]
        },
        "schema_version": {
            "const": "invoke.cli-authoring-request.v1"
        },
        "stage": {
            "type": "string",
            "minLength": 1
        }
    },
    "required": [
        "$schema",
        "document",
        "evidence_paths",
        "mode",
        "schema_version",
        "stage"
    ]
}
