    "required": [
        "audit_id",
        "authority_class",
        "closeout_directory",
        "control_artifacts",
        "immutable_paths",
        "next_owner",
        "publication_class",
        "refresh_targets",
        "repository_root",
        "schema_version",
        "shared_write_owners",
        "source_selectors",
