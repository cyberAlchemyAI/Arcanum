{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "allowed_routes": {
            "allOf": [
                {
                    "prefixItems": [
                        true
                    ]
                },
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "capability": {
                                "type": "string",
                                "minLength": 1
                            },
                            "effect_class": {
                                "const": "repository-local-reversible"
                            },
                            "expected_receipt": {
                                "type": "string",
                                "minLength": 1
                            },
                            "frontier_swu": {
                                "type": "string",
                                "minLength": 1
                            },
                            "mode": {
                                "type": "string",
                                "minLength": 1
                            },
                            "required_inputs": {
                                "type": "array",
                                "prefixItems": [
                                    true
                                ],
                                "minItems": 1,
                                "uniqueItems": true
                            },
                            "route_id": {
                                "type": "string",
                                "minLength": 1
                            },
                            "target": {
                                "type": "string",
                                "minLength": 1
                            },
                            "write_scope": {
                                "type": "array",
                                "prefixItems": [
                                    true
                                ],
                                "minItems": 1,
                                "uniqueItems": true
                            }
                        },
                        "required": [
                            "capability",
                            "effect_class",
                            "expected_receipt",
                            "frontier_swu",
                            "mode",
                            "required_inputs",
                            "route_id",
                            "target",
                            "write_scope"
                        ]
                    },
                    "minItems": 1
                }
            ]
        },
        "allowed_routes_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "approval_status": {
            "const": "unapproved"
        },
        "audit_id": {
            "type": "string",
            "minLength": 1
        },
        "authority_effect": {
            "const": "none"
        },
        "execution_entry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "blocker_code": {
                    "type": "null"
                },
                "entry_state": {
                    "const": "selection-ready"
                },
                "next_owner": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "capability": {
                            "const": "implementation-readiness"
                        },
                        "mode": {
                            "const": "execute"
                        },
                        "target": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "required": [
                        "capability",
                        "mode",
                        "target"
                    ]
                },
                "route_id": {
                    "type": "null"
                },
                "selected_unit": {
                    "type": "null"
                }
            },
            "required": [
                "blocker_code",
                "entry_state",
                "next_owner",
                "route_id",
                "selected_unit"
            ]
        },
        "manifest_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "size_bytes": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                }
            },
            "required": [
                "path",
                "sha256",
                "size_bytes"
            ]
        },
        "mutation_ready": {
            "const": false
        },
        "next_owner": {
            "const": "implementation-readiness:execute"
        },
        "plan_epoch_id": {
            "type": "string",
            "pattern": "^epoch-[a-f0-9]{24}$"
        },
        "ready_frontier": {
            "allOf": [
                {
                    "prefixItems": [
                        true
                    ]
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                }
            ]
        },
        "schema_version": {
            "const": "1.0.0"
        },
        "selection_required": {
            "const": true
        }
    },
    "required": [
        "allowed_routes",
        "allowed_routes_digest",
        "approval_status",
        "audit_id",
        "authority_effect",
        "execution_entry",
        "manifest_ref",
        "mutation_ready",
        "next_owner",
        "plan_epoch_id",
        "ready_frontier",
        "schema_version",
        "selection_required"
    ]
}
