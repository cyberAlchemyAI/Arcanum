@@ -198,6 +198,22 @@ class Estimator(ABC):
         return float(self.test_scorer(self.y_val, y_val_pred))
 
 
+class ParameterizedEstimator(Estimator):
+    """Base class for estimators that can be built from keyword parameters."""
+
+    estimator_cls = None
+
+    def make_estimator(self, params):
+        """Return an estimator instance for a combination of parameters."""
+        if self.estimator_cls is None:
+            raise NotImplementedError("estimator_cls must be set on the benchmark")
+
+        return self.estimator_cls(**self.estimator_kwargs(params))
+
+    def estimator_kwargs(self, params):
+        return {}
+
+
 class Predictor(ABC):
     """Abstract base class for benchmarks of estimators implementing predict"""
 
