{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/distill/common/2-0-0",
  "schema_version": "distill.common.v2",
  "title": "Distill v2 Common Structural Primitives",
  "$defs": {
    "canonical_identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
    },
    "state_field_reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*)+(?![\\s\\S])"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "unique_non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "unique_canonical_identifier_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/canonical_identifier"}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "repository_relative_path": {
      "type": "string",
      "minLength": 1
    },
    "exact_artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "bounded_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "default", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/positive_integer"},
        "default": {"$ref": "#/$defs/positive_integer"},
        "maximum": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "authority_effect_none": {
      "const": "none"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "json_scalar": {
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "structured_value_level_1": {
      "oneOf": [
        {"$ref": "#/$defs/json_scalar"},
        {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/json_scalar"}
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/canonical_identifier"},
          "additionalProperties": {"$ref": "#/$defs/json_scalar"}
        }
      ]
    },
    "structured_value_level_2": {
      "oneOf": [
        {"$ref": "#/$defs/json_scalar"},
        {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/structured_value_level_1"}
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/canonical_identifier"},
          "additionalProperties": {"$ref": "#/$defs/structured_value_level_1"}
        }
      ]
    }
  }
}
