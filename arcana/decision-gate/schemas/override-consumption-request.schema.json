{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/decision-gate/override-consumption-request/1-0-0",
  "title": "DecisionGateOverrideConsumptionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target",
    "scope",
    "hazard_class"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hazard_class": {
      "enum": [
        "reversible",
        "destructive",
        "authority",
        "promotion",
        "publication",
        "spend",
        "other"
      ]
    }
  }
}
