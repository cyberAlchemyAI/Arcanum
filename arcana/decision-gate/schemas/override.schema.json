{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/decision-gate/override/1-0-0",
  "title": "DecisionGateOverride",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "override_id",
    "target",
    "scope",
    "hazard_class",
    "issuer",
    "rationale",
    "issued_at",
    "expires_at",
    "owner_gate_receipt",
    "consumed_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "override_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hazard_class": {
      "enum": [
        "reversible",
        "destructive",
        "authority",
        "promotion",
        "publication",
        "spend",
        "other"
      ]
    },
    "issuer": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": ["string", "null"], "minLength": 1},
    "owner_gate_receipt": {"type": ["string", "null"], "minLength": 1},
    "consumed_by": {"type": ["string", "null"], "minLength": 1}
  }
}
