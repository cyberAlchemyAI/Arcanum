{
  "schema_version": "ontology-vault-cav2-public-export-policy/v1",
  "contract_id": "cav2-to-arcanum-ontology-contracts/v1",
  "status": "owner-approved-bounded-export",
  "source_system": "CyberAlchemy v2",
  "target_scope": "Arcanum Ontology Vault capability-local contracts",
  "authority_effect": "none",
  "arcanum_definition_authority": false,
  "ontology_decides_authority": false,
  "allowed_artifact_classes": [
    "ontology-definition-contract",
    "ontology-model-contract"
  ],
  "allowed_definition_ids": [
    "CAV2-D16",
    "CAV2-D23",
    "CAV2-D29",
    "CAV2-D32",
    "CAV2-D33",
    "CAV2-D34",
    "CAV2-D35",
    "CAV2-D36",
    "CAV2-D37",
    "CAV2-D38",
    "CAV2-D39",
    "CAV2-D40",
    "CAV2-D54"
  ],
  "allowed_model_contract_ids": [
    "package",
    "node",
    "relation",
    "branch-view",
    "authority-kind",
    "authority-posture",
    "lifecycle-separation"
  ],
  "forbidden_artifact_classes": [
    "proof",
    "executable-script",
    "private-source-evidence",
    "session-or-telemetry",
    "research-or-development-record",
    "other-system-material",
    "promotion-or-release-record"
  ],
  "forbidden_public_path_fragments": [
    "/home/",
    ".arcanum/",
    "cyberAlchemy-v2/",
    "projects/",
    "development/",
    "research/",
    "sessions/",
    "telemetry/",
    "proofs/",
    "scripts/"
  ],
  "forbidden_public_keys": [
    "private_source_path",
    "private_source_digest",
    "proof_ref",
    "promotion_verdict",
    "release_admission"
  ],
  "public_provenance_requires": [
    "source_system",
    "origin_id",
    "derivation",
    "authority_effect"
  ],
  "private_export_receipt_requires": [
    "exact_source_path",
    "exact_source_digest",
    "source_selector",
    "public_target_path",
    "public_target_digest",
    "scrub_checks"
  ],
  "boundary": "Public contracts may preserve reusable ontology semantics and origin identifiers. Exact private provenance, evidence, proofs, executable sources, and owner decisions remain outside public Arcanum."
}
