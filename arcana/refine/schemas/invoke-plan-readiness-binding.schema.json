{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/refine/invoke-plan-readiness-binding/1-0-0",
  "title": "InvokePlanReadinessBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_designation",
    "work_pack_id",
    "readiness_receipt_ref",
    "non_execution_reason",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "refine.invoke-plan-readiness-binding/v1"
    },
    "execution_designation": {
      "enum": ["execution-candidate", "non-executing"]
    },
    "work_pack_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "readiness_receipt_ref": {
      "oneOf": [
        {"$ref": "#/$defs/exactArtifactRef"},
        {"type": "null"}
      ]
    },
    "non_execution_reason": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_designation": {"const": "execution-candidate"}
        },
        "required": ["execution_designation"]
      },
      "then": {
        "properties": {
          "work_pack_id": {"type": "string", "minLength": 1},
          "readiness_receipt_ref": {"$ref": "#/$defs/exactArtifactRef"},
          "non_execution_reason": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "work_pack_id": {"type": "null"},
          "readiness_receipt_ref": {"type": "null"},
          "non_execution_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
