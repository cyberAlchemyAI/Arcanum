{
  "name": "intent-route-resolver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "check": "node scripts/validate-contract.mjs && node scripts/scan-boundary.mjs && node --test test/*.test.mjs",
    "check:source": "node scripts/validate-contract.mjs --check source-license-api",
    "test": "node --test test/*.test.mjs",
    "witness:node": "node scripts/run-node-witness.mjs --output development/runs/node-witness.json"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./json-port": "./src/json-port.mjs",
    "./addon-manifest": "./addon-manifest.json"
  }
}
