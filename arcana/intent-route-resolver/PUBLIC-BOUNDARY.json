{
  "schema": "intent-route.public-boundary@1",
  "scope": "canonical-source-closure",
  "text_rules": {
    "forbid_absolute_home_paths": true,
    "forbid_product_or_repository_identifiers": true,
    "forbid_network_uris_in_executable_source": true
  },
  "import_rules": {
    "allow_node_builtins": true,
    "allow_package_relative_imports": true,
    "forbid_parent_escape": true,
    "forbid_external_packages": true,
    "forbid_network_imports": true
  },
  "runtime_rules": {
    "forbid_process_spawn": true,
    "forbid_network_access": true,
    "forbid_filesystem_write": true,
    "forbid_environment_semantics": true
  },
  "authority_effect": "none"
}
