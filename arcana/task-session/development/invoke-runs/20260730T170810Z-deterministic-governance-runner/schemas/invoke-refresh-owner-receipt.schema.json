{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/planning/invoke-refresh-owner-receipt/1-0-0",
  "title": "InvokeRefreshOwnerReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "route_tuple",
    "source_receipt_ref",
    "material_package_receipt_ref",
    "target_inventory",
    "baseline_state",
    "applied_delta_classes",
    "validation",
    "result",
    "returned_next_route",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "invoke.refresh-owner-receipt.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "route_tuple": {
      "const": "invoke:refresh:apply-approved"
    },
    "source_receipt_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "material_package_receipt_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "target_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_state": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/digest"
          },
          {
            "const": "absent"
          }
        ]
      }
    },
    "applied_delta_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "evidence_added",
          "blocker_opened",
          "blocker_resolved",
          "status_changed",
          "route_changed"
        ]
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "enum": [
        "pass",
        "no-op",
        "block"
      ]
    },
    "returned_next_route": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "receipt_digest": {
      "allOf": [
        {
          "$ref": "#/$defs/digest"
        }
      ],
      "description": "Lowercase SHA-256 of the UTF-8 JSON serialization after removing the top-level receipt_digest member, sorting every object key lexicographically, preserving array order, emitting no insignificant whitespace, escaping only characters required by JSON, and emitting no trailing newline."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
