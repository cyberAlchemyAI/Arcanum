{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/mutation-admission-request/1-1-0",
  "title": "TaskSessionMutationAdmissionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionMode"],
  "properties": {
    "schemaVersion": {"const": "1.1.0"},
    "executionMode": {
      "enum": ["routed-mutation", "reusable-mutation", "standalone-nonmutating"]
    },
    "taskId": {"type": "string", "minLength": 1},
    "swuId": {"type": "string", "minLength": 1},
    "controlArtifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/controlArtifact"}
    },
    "dependencyFrontier": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "materialPackage": {"$ref": "#/$defs/exactArtifactRef"},
    "materialReceipt": {"$ref": "#/$defs/exactArtifactRef"},
    "producerReceiptSchema": {"$ref": "#/$defs/exactArtifactRef"},
    "materialWrites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "executionOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowedWrites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lifecycleOwner": {"type": "string", "minLength": 1},
    "authorityClass": {"enum": ["public", "private"]},
    "publicationClass": {"enum": ["public", "private", "internal"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionMode": {
            "enum": ["routed-mutation", "reusable-mutation"]
          }
        },
        "required": ["executionMode"]
      },
      "then": {
        "required": [
          "taskId",
          "swuId",
          "controlArtifacts",
          "dependencyFrontier",
          "materialPackage",
          "materialReceipt",
          "producerReceiptSchema",
          "materialWrites",
          "executionOutputs",
          "allowedWrites",
          "validationCommands",
          "lifecycleOwner",
          "authorityClass",
          "publicationClass"
        ]
      }
    }
  ],
  "$defs": {
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    },
    "controlArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sizeBytes",
        "role",
        "authorityClass"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "role": {
          "enum": [
            "task-contract",
            "work-pack",
            "context-pack",
            "source"
          ]
        },
        "authorityClass": {"enum": ["public", "private"]}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyId", "artifactRef"],
      "properties": {
        "dependencyId": {"type": "string", "minLength": 1},
        "artifactRef": {"$ref": "#/$defs/exactArtifactRef"}
      }
    }
  }
}
