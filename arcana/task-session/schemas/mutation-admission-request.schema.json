{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/mutation-admission-request/1-2-0",
  "title": "TaskSessionMutationAdmissionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionMode"],
  "properties": {
    "schemaVersion": {"const": "1.2.0"},
    "admissionProfile": {"const": "plan-once-selected-unit"},
    "executionMode": {
      "enum": ["routed-mutation", "reusable-mutation", "standalone-nonmutating"]
    },
    "taskId": {"type": "string", "minLength": 1},
    "swuId": {"type": "string", "minLength": 1},
    "controlArtifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/controlArtifact"}
    },
    "dependencyFrontier": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "materialPackage": {"$ref": "#/$defs/exactArtifactRef"},
    "materialReceipt": {"$ref": "#/$defs/exactArtifactRef"},
    "producerReceiptSchema": {"$ref": "#/$defs/exactArtifactRef"},
    "materialWrites": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "executionOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowedWrites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lifecycleOwner": {"type": "string", "minLength": 1},
    "authorityClass": {"enum": ["public", "private"]},
    "publicationClass": {"enum": ["public", "private", "internal"]}
    ,
    "planAdmission": {"$ref": "#/$defs/planAdmission"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionMode": {
            "enum": ["routed-mutation", "reusable-mutation"]
          }
        },
        "required": ["executionMode"]
      },
      "then": {
        "required": [
          "taskId",
          "swuId",
          "controlArtifacts",
          "dependencyFrontier",
          "materialWrites",
          "executionOutputs",
          "allowedWrites",
          "validationCommands",
          "lifecycleOwner",
          "authorityClass",
          "publicationClass"
        ],
        "oneOf": [
          {
            "required": [
              "materialPackage",
              "materialReceipt",
              "producerReceiptSchema"
            ],
            "properties": {
              "materialWrites": {"minItems": 1}
            }
          },
          {
            "properties": {
              "materialWrites": {"maxItems": 0},
              "executionOutputs": {"minItems": 1}
            },
            "not": {
              "anyOf": [
                {"required": ["materialPackage"]},
                {"required": ["materialReceipt"]},
                {"required": ["producerReceiptSchema"]}
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "admissionProfile": {"const": "plan-once-selected-unit"}
        },
        "required": ["admissionProfile"]
      },
      "then": {
        "required": ["planAdmission"],
        "properties": {
          "executionMode": {"enum": ["routed-mutation", "reusable-mutation"]}
        }
      }
    }
  ],
  "$defs": {
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    },
    "controlArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sizeBytes",
        "role",
        "authorityClass"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "role": {
          "enum": [
            "task-contract",
            "work-pack",
            "context-pack",
            "source"
          ]
        },
        "authorityClass": {"enum": ["public", "private"]}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyId", "artifactRef"],
      "properties": {
        "dependencyId": {"type": "string", "minLength": 1},
        "artifactRef": {"$ref": "#/$defs/exactArtifactRef"}
      }
    },
    "baselineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "sha256", "sizeBytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["absent", "present"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "absent"}}},
          "then": {"properties": {"sha256": {"type": "null"}, "sizeBytes": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"const": "present"}}},
          "then": {
            "properties": {
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "sizeBytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      ]
    },
    "planAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planManifest",
        "planManifestSchema",
        "selectionReceipt",
        "selectionReceiptSchema",
        "planEpochId",
        "unitContractDigest",
        "attemptId",
        "targetBaselines",
        "structuredValidationContracts",
        "validationContractDigest"
      ],
      "properties": {
        "planManifest": {"$ref": "#/$defs/exactArtifactRef"},
        "planManifestSchema": {"$ref": "#/$defs/exactArtifactRef"},
        "selectionReceipt": {"$ref": "#/$defs/exactArtifactRef"},
        "selectionReceiptSchema": {"$ref": "#/$defs/exactArtifactRef"},
        "planEpochId": {"type": "string", "pattern": "^epoch-[a-f0-9]{24}$"},
        "unitContractDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attemptId": {"type": "string", "minLength": 1},
        "targetBaselines": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/baselineEntry"}
        },
        "validationContractDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        ,
        "structuredValidationContracts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/structuredValidationCommand"}
        }
      }
    },
    "structuredValidationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "argv", "cwd", "timeout_seconds", "max_output_bytes"],
      "properties": {
        "command_id": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    }
  }
}
