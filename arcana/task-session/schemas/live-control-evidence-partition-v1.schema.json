{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/live-control-evidence-partition/1-0-0",
  "title": "TaskSessionLiveControlEvidencePartitionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "repository_root",
    "outputs",
    "exact_union_scope"
  ],
  "properties": {
    "schema_version": {"const": "task-session.live-control-evidence-partition.v1"},
    "attempt_id": {"$ref": "#/$defs/nonEmptyString"},
    "repository_root": {"const": "."},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/controlOutput"}
    },
    "exact_union_scope": {"$ref": "#/$defs/nonEmptyPathSet"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    },
    "nonEmptyPathSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sha256", "size_bytes"],
      "properties": {
        "state": {"const": "absent"},
        "sha256": {"type": "null"},
        "size_bytes": {"type": "null"}
      }
    },
    "controlOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "owner_capability",
        "write_class",
        "attempt_id",
        "baseline",
        "runtime_revalidation"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "owner_capability": {"$ref": "#/$defs/nonEmptyString"},
        "write_class": {
          "enum": [
            "readiness-evidence",
            "selection-evidence",
            "fast-entry-evidence",
            "context-evidence",
            "admission-evidence",
            "governance-checkpoint",
            "execution-ticket",
            "consumption-ledger",
            "reconciliation-evidence",
            "commit-evidence",
            "preparation-receipt"
          ]
        },
        "attempt_id": {"$ref": "#/$defs/nonEmptyString"},
        "baseline": {"$ref": "#/$defs/baseline"},
        "expected_postimage_ref": {"$ref": "#/$defs/exactArtifactRef"},
        "runtime_revalidation": {
          "enum": ["baseline-before-write", "exact-postimage-before-consume"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"runtime_revalidation": {"const": "exact-postimage-before-consume"}}, "required": ["runtime_revalidation"]},
          "then": {"required": ["expected_postimage_ref"]}
        }
      ]
    }
  }
}
