{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session/mutation-admission-receipt/1-3-0",
  "title": "TaskSessionMutationAdmissionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionMode",
    "writeProfile",
    "admissionVerdict",
    "mutationReady",
    "taskId",
    "swuId",
    "requestDigest",
    "producerSchemaDigest",
    "materialReceiptDigest",
    "materialPackageDigest",
    "controllingPaths",
    "dependencyIds",
    "materialWrites",
    "executionOutputs",
    "allowedWrites",
    "validationCommands",
    "lifecycleOwner",
    "authorityClass",
    "publicationClass",
    "liveValidationRequired",
    "reasons"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.2.0", "1.3.0"]},
    "admissionProfile": {
      "oneOf": [
        {"const": "plan-once-selected-unit"},
        {"type": "null"}
      ]
    },
    "executionMode": {
      "enum": ["routed-mutation", "reusable-mutation", "standalone-nonmutating", "invalid"]
    },
    "writeProfile": {
      "enum": ["material-bound", "execution-output-only", "nonmutating", "invalid"]
    },
    "admissionVerdict": {"enum": ["admit", "block", "not-applicable"]},
    "mutationReady": {"type": "boolean"},
    "taskId": {"type": ["string", "null"], "minLength": 1},
    "swuId": {"type": ["string", "null"], "minLength": 1},
    "requestDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "producerSchemaDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialReceiptDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialPackageDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "controllingPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependencyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "materialWrites": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "executionOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "transientOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowedWrites": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validationCommands": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lifecycleOwner": {"type": ["string", "null"], "minLength": 1},
    "authorityClass": {"enum": ["public", "private", null]},
    "publicationClass": {"enum": ["public", "private", "internal", null]},
    "planEpochId": {"type": ["string", "null"], "pattern": "^epoch-[a-f0-9]{24}$"},
    "unitContractDigest": {"$ref": "#/$defs/nullableSha256"},
    "attemptId": {"type": ["string", "null"], "minLength": 1},
    "planManifestDigest": {"$ref": "#/$defs/nullableSha256"},
    "selectionReceiptDigest": {"$ref": "#/$defs/nullableSha256"},
    "targetBaselineDigest": {"$ref": "#/$defs/nullableSha256"},
    "targetBaselines": {
      "type": ["array", "null"],
      "items": {"$ref": "#/$defs/baselineEntry"}
    },
    "validationContractDigest": {"$ref": "#/$defs/nullableSha256"},
    "admissionToken": {"$ref": "#/$defs/nullableSha256"},
    "singleUse": {"type": ["boolean", "null"]},
    "liveValidationRequired": {"type": "boolean"},
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": "1.3.0"}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["transientOutputs"]
      },
      "else": {
        "not": {"required": ["transientOutputs"]}
      }
    },
    {
      "if": {
        "properties": {"admissionVerdict": {"const": "admit"}},
        "required": ["admissionVerdict"]
      },
      "then": {
        "properties": {
          "mutationReady": {"const": true},
          "liveValidationRequired": {"const": true},
          "reasons": {"maxItems": 0},
          "transientOutputs": {
            "if": {"type": "array"},
            "then": {"minItems": 1}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissionProfile": {"const": "plan-once-selected-unit"},
          "admissionVerdict": {"const": "admit"}
        },
        "required": ["admissionProfile", "admissionVerdict"]
      },
      "then": {
        "required": [
          "planEpochId",
          "unitContractDigest",
          "attemptId",
          "planManifestDigest",
          "selectionReceiptDigest",
          "targetBaselineDigest",
          "targetBaselines",
          "validationContractDigest",
          "admissionToken",
          "singleUse"
        ],
        "properties": {
          "planEpochId": {"type": "string"},
          "unitContractDigest": {"$ref": "#/$defs/sha256"},
          "attemptId": {"type": "string"},
          "planManifestDigest": {"$ref": "#/$defs/sha256"},
          "selectionReceiptDigest": {"$ref": "#/$defs/sha256"},
          "targetBaselineDigest": {"$ref": "#/$defs/sha256"},
          "targetBaselines": {"type": "array", "minItems": 1},
          "validationContractDigest": {"$ref": "#/$defs/sha256"},
          "admissionToken": {"$ref": "#/$defs/sha256"},
          "singleUse": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"admissionVerdict": {"const": "block"}},
        "required": ["admissionVerdict"]
      },
      "then": {
        "properties": {
          "mutationReady": {"const": false},
          "reasons": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"writeProfile": {"const": "material-bound"}},
        "required": ["writeProfile"]
      },
      "then": {
        "properties": {
          "materialWrites": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "writeProfile": {"const": "material-bound"},
          "admissionVerdict": {"const": "admit"}
        },
        "required": ["writeProfile", "admissionVerdict"]
      },
      "then": {
        "properties": {
          "producerSchemaDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "materialReceiptDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "materialPackageDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"writeProfile": {"const": "execution-output-only"}},
        "required": ["writeProfile"]
      },
      "then": {
        "properties": {
          "producerSchemaDigest": {"type": "null"},
          "materialReceiptDigest": {"type": "null"},
          "materialPackageDigest": {"type": "null"},
          "materialWrites": {"maxItems": 0},
          "executionOutputs": {"minItems": 1},
          "liveValidationRequired": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"admissionVerdict": {"const": "not-applicable"}},
        "required": ["admissionVerdict"]
      },
      "then": {
        "properties": {
          "executionMode": {"const": "standalone-nonmutating"},
          "writeProfile": {"const": "nonmutating"},
          "mutationReady": {"const": false},
          "liveValidationRequired": {"const": false},
          "reasons": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "baselineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "sha256", "sizeBytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["absent", "present"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
