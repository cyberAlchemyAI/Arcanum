{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/continuation-router/work-pack-route-request/1-0-0",
  "title": "WorkPackRouteRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_policy",
    "execution_entry",
    "execution_binding",
    "candidate_routes",
    "installed_owner_routes",
    "available_inputs",
    "consumed_route_fingerprints",
    "authorization_flag",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "execution_policy": {"type": "object"},
    "execution_entry": {"type": "object"},
    "execution_binding": {"type": "object"},
    "candidate_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/route"}
    },
    "installed_owner_routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ownerRoute"}
    },
    "available_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "consumed_route_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "authorization_flag": {"type": "null"},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ownerRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "mode"],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "frontier_swu",
        "capability",
        "mode",
        "target",
        "write_scope",
        "effect_class",
        "required_inputs",
        "expected_receipt"
      ],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "frontier_swu": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "effect_class": {"type": "string", "minLength": 1},
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_receipt": {"type": "string", "minLength": 1}
      }
    }
  }
}
