{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/implementation-readiness/outer-loop-state/1-2-0",
  "title": "WorkPackOuterLoopState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "loop_id",
    "source_invocation_id",
    "created_at",
    "work_pack_id",
    "work_pack_semantic_digest",
    "allowed_routes_digest",
    "execution_mode",
    "captured_frontier",
    "completion_continuity",
    "phase",
    "current_entry",
    "current_binding",
    "binding_ids",
    "pending_action_id",
    "pending_task_session_id",
    "step_budget",
    "steps_used",
    "visited_units",
    "consumed_route_fingerprints",
    "route_retry_counts",
    "pending_retry",
    "owner_receipts",
    "task_session_receipts",
    "automatic_decisions",
    "authorization_prompt_count",
    "pending_stop_decision",
    "stop_reason",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "loop_id": {"type": "string", "pattern": "^wpol-[a-f0-9]{24}$"},
    "source_invocation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "work_pack_id": {"type": "string", "minLength": 1},
    "work_pack_semantic_digest": {"$ref": "#/$defs/sha256"},
    "allowed_routes_digest": {"$ref": "#/$defs/sha256"},
    "execution_mode": {"enum": ["one-unit", "finite-frontier", "until-real-blocker"]},
    "captured_frontier": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completion_continuity": {"$ref": "#/$defs/completionContinuity"},
    "phase": {
      "enum": [
        "ready",
        "awaiting-selection",
        "awaiting-owner",
        "awaiting-task-session",
        "complete",
        "blocked"
      ]
    },
    "current_entry": {"type": "object"},
    "current_binding": {"type": "object"},
    "binding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pending_action_id": {"type": ["string", "null"], "minLength": 1},
    "pending_task_session_id": {"type": ["string", "null"], "minLength": 1},
    "step_budget": {"type": "integer", "minimum": 1},
    "steps_used": {"type": "integer", "minimum": 0},
    "visited_units": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "consumed_route_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "route_retry_counts": {
      "type": "object",
      "patternProperties": {
        "^[a-f0-9]{64}$": {"type": "integer", "const": 1}
      },
      "additionalProperties": false
    },
    "pending_retry": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_fingerprint", "blocker_code", "owner_receipt_id"],
          "properties": {
            "route_fingerprint": {"$ref": "#/$defs/sha256"},
            "blocker_code": {"const": "REPAIRABLE_OWNER_CONDITION"},
            "owner_receipt_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "owner_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/ownerReceipt"}
    },
    "task_session_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/taskSessionReceipt"}
    },
    "automatic_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/automaticDecision"}
    },
    "authorization_prompt_count": {"const": 0},
    "pending_stop_decision": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "stop_reason": {"type": ["string", "null"], "minLength": 1},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "completedPrefixItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "unit_contract_digest", "completion_binding_id", "completion_artifact_ref", "closeout_binding_id"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "unit_contract_digest": {"$ref": "#/$defs/sha256"},
        "completion_binding_id": {"type": "string", "minLength": 1},
        "completion_artifact_ref": {"$ref": "#/$defs/exactArtifactRef"},
        "closeout_binding_id": {"type": "string", "minLength": 1}
      }
    },
    "completionContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_audit_id", "source_projection_digest", "work_pack_semantic_digest", "plan_epoch_id", "completed_prefix", "next_unit", "authority_effect", "continuity_digest"],
      "properties": {
        "source_audit_id": {"type": "string", "minLength": 1},
        "source_projection_digest": {"$ref": "#/$defs/sha256"},
        "work_pack_semantic_digest": {"$ref": "#/$defs/sha256"},
        "plan_epoch_id": {"type": "string", "pattern": "^epoch-[a-f0-9]{24}$"},
        "completed_prefix": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/completedPrefixItem"}},
        "next_unit": {"type": ["string", "null"], "minLength": 1},
        "authority_effect": {"const": "none"},
        "continuity_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "ownerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "result",
        "capability",
        "mode",
        "route_fingerprint",
        "blocker_code"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "block", "retry"]},
        "capability": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "route_fingerprint": {"$ref": "#/$defs/sha256"},
        "blocker_code": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"result": {"const": "retry"}},
            "required": ["result"]
          },
          "then": {
            "properties": {
              "blocker_code": {"const": "REPAIRABLE_OWNER_CONDITION"}
            }
          }
        },
        {
          "if": {
            "properties": {"result": {"const": "pass"}},
            "required": ["result"]
          },
          "then": {"properties": {"blocker_code": {"type": "null"}}}
        }
      ]
    },
    "taskSessionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "session_id",
        "selected_unit",
        "result",
        "route_fingerprint"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "selected_unit": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "block"]},
        "route_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "automaticDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "decision_class", "action_type", "selected_unit"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "decision_class": {"type": "string", "minLength": 1},
        "action_type": {
          "enum": ["select-unit", "route-owner", "start-task-session"]
        },
        "selected_unit": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
