{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/implementation-readiness/execution-intent-binding/1-1-0",
  "title": "ExecutionIntentBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "source_invocation_id",
    "created_at",
    "work_pack_id",
    "work_pack_semantic_digest",
    "captured_frontier",
    "completion_continuity_digest",
    "selected_unit",
    "execution_mode",
    "allowed_routes_digest",
    "current_route",
    "write_scope_union",
    "validation_commands",
    "automatic_decisions",
    "stop_decisions",
    "route_fingerprint",
    "authority_effect",
    "binding_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "binding_id": {"type": "string", "pattern": "^wpeb-[a-f0-9]{24}$"},
    "source_invocation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "work_pack_id": {"type": "string", "minLength": 1},
    "work_pack_semantic_digest": {"$ref": "#/$defs/sha256"},
    "captured_frontier": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completion_continuity_digest": {"$ref": "#/$defs/sha256"},
    "selected_unit": {"type": ["string", "null"], "minLength": 1},
    "execution_mode": {"enum": ["one-unit", "finite-frontier", "until-real-blocker"]},
    "allowed_routes_digest": {"$ref": "#/$defs/sha256"},
    "current_route": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/allowedRoute"}]},
    "write_scope_union": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "automatic_decisions": {"type": "array", "minItems": 1, "uniqueItems": true},
    "stop_decisions": {"type": "array", "minItems": 1, "uniqueItems": true},
    "route_fingerprint": {"$ref": "#/$defs/sha256"},
    "authority_effect": {"const": "bounded-execution-only"},
    "binding_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "frontier_swu",
        "capability",
        "mode",
        "target",
        "write_scope",
        "effect_class",
        "required_inputs",
        "expected_receipt"
      ],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "frontier_swu": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "write_scope": {"type": "array", "minItems": 1, "uniqueItems": true},
        "effect_class": {"type": "string", "minLength": 1},
        "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "expected_receipt": {"type": "string", "minLength": 1}
      }
    }
  }
}
