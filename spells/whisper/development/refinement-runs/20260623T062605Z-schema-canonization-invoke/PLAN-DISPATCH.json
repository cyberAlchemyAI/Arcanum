        ],
        "on_missing": "block"
      }
    ],
    "state_namespaces": [
      {
        "namespace": "canonical-whisper-source",
        "owner": "arcanum/spells/whisper",
        "write_policy": "Stable schema package and README edits require lifecycle acceptance."
      },
      {
        "namespace": "development-evidence",
        "owner": "arcanum/spells/whisper/development",
        "write_policy": "Run-local artifacts remain provenance and examples unless explicitly promoted."
      },
      {
        "namespace": "generated-runtime-surfaces",
        "owner": "bootstrap/runtime installer",
        "write_policy": "Regenerate from canonical source; do not hand-author generated mirrors."
      }
