    "objective": "Plan review and promotion of Whisper schema artifacts from development evidence into a stable canonical schema package.",
    "target_artifact": "arcanum/spells/whisper",
    "arcanum_vocabulary": [
      "invoke",
      "whisper",
      "spellcraft",
      "task-session",
      "experiment-harness",
      "text_intent_substrate",
      "readability_dynamics"
    ]
  },
  "mode": "sequence",
  "techniques": [
    "sequence",
    "scu_swu_reduction",
    "recomposition_proof",
    "validation_loop",
    "owner_boundary_check",
    "handle_handoff",
    "residue_ledger",
    "execution_receipt_handoff",
    "delegation_boundary",
    "authority_split_gate",
    "artifact_contract_bridge",
    "concrete_path_evidence",
    "state_namespace_boundary"
