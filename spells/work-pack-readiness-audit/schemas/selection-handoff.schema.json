{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/work-pack-readiness-audit/selection-handoff/1-0-0",
  "title": "PlanSelectionHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "plan_epoch_id",
    "manifest_ref",
    "ready_frontier",
    "allowed_routes",
    "allowed_routes_digest",
    "execution_entry",
    "next_owner",
    "approval_status",
    "selection_required",
    "authority_effect",
    "mutation_ready"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "minLength": 1},
    "plan_epoch_id": {"type": "string", "pattern": "^epoch-[a-f0-9]{24}$"},
    "manifest_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "ready_frontier": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/allowedRoute"}
    },
    "allowed_routes_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_entry": {"$ref": "#/$defs/executionEntry"},
    "next_owner": {"const": "implementation-readiness:execute"},
    "approval_status": {"const": "unapproved"},
    "selection_required": {"const": true},
    "authority_effect": {"const": "none"},
    "mutation_ready": {"const": false}
  },
  "$defs": {
    "allowedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "frontier_swu",
        "capability",
        "mode",
        "target",
        "write_scope",
        "effect_class",
        "required_inputs",
        "expected_receipt"
      ],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "frontier_swu": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "write_scope": {"type": "array", "minItems": 1, "uniqueItems": true},
        "effect_class": {"const": "repository-local-reversible"},
        "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "expected_receipt": {"type": "string", "minLength": 1}
      }
    },
    "executionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_state", "selected_unit", "route_id", "next_owner", "blocker_code"],
      "properties": {
        "entry_state": {"const": "selection-ready"},
        "selected_unit": {"type": "null"},
        "route_id": {"type": "null"},
        "next_owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "mode", "target"],
          "properties": {
            "capability": {"const": "implementation-readiness"},
            "mode": {"const": "execute"},
            "target": {"type": "string", "minLength": 1}
          }
        },
        "blocker_code": {"type": "null"}
      }
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
