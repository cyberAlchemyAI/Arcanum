{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session-until-blocker/closeout-no-op-proof/1-0-0",
  "title": "CloseoutNoOpProof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "unit_id",
    "before_inventory",
    "after_inventory",
    "observed_delta",
    "closeout_contract_ref",
    "validator",
    "continuation_router_verification",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proof_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "before_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inventoryEntry"}
    },
    "after_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inventoryEntry"}
    },
    "observed_delta": {"type": "array", "maxItems": 0},
    "closeout_contract_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "executable_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "continuation_router_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "status", "canonical_successor"],
      "properties": {
        "receipt_ref": {"$ref": "#/$defs/exactArtifactRef"},
        "status": {"const": "verified"},
        "canonical_successor": {"type": ["string", "null"]}
      }
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
