{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/task-session-until-blocker/finite-stream-execution-acceptance/1-0-0",
  "title": "FiniteStreamExecutionAcceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_status",
    "supervisor_id",
    "scope_id",
    "work_pack_id",
    "work_pack_semantic_digest",
    "allowed_routes_digest",
    "source_invocation_id",
    "execution_mode",
    "captured_frontier",
    "chain_config_ref",
    "fast_entry_request_ref",
    "fast_entry_receipt_ref",
    "max_task_session_requests",
    "risk_ceiling",
    "automatic_decisions",
    "stop_decisions",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "task-session-until-blocker.finite-stream-execution-acceptance/v1"
    },
    "approval_status": {"const": "approved"},
    "supervisor_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "work_pack_id": {"type": "string", "minLength": 1},
    "work_pack_semantic_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowed_routes_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_invocation_id": {"type": "string", "minLength": 1},
    "execution_mode": {"const": "finite-frontier"},
    "captured_frontier": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "chain_config_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "fast_entry_request_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "fast_entry_receipt_ref": {"$ref": "#/$defs/exactArtifactRef"},
    "max_task_session_requests": {"type": "integer", "minimum": 1},
    "risk_ceiling": {
      "enum": ["read-only", "bounded-write", "browser", "network"]
    },
    "automatic_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_effect": {"const": "bounded-execution-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
