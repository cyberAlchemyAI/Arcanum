{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/preacceptance-closure-review/1-0-0",
  "title": "InvokePreacceptanceClosureReviewV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "manifest_ref",
    "closure_receipt_ref",
    "closure_graph_digest",
    "reviewer",
    "result",
    "checks",
    "authority_effect",
    "claim_ceiling",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "invoke.preacceptance-closure-review.v1"
    },
    "review_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "manifest_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "closure_receipt_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "closure_graph_digest": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "role",
        "declared_separation_from",
        "attestation_ref"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "const": "closure-bound-review-attestor"
        },
        "declared_separation_from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "attestation_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "block"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/reviewCheck"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "result",
        "detail",
        "evidence_refs"
      ],
      "properties": {
        "check_id": {
          "enum": [
            "final_postimages",
            "execution_projection",
            "consumer_closure",
            "write_partition",
            "runner_identity",
            "schema_locator",
            "stage_binding",
            "requested_effect",
            "reflection_adoption",
            "no_effect_determinism"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "block"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactArtifactRef"
          }
        }
      }
    }
  }
}
