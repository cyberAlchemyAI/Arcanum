{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-scope-manifest/1-0-0",
  "title": "InvokeDesignScopeManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "target_id",
    "target_footprint",
    "source_contracts",
    "human_actors",
    "rendered_surfaces",
    "interfaces",
    "stores",
    "queues",
    "writers",
    "normative_rules",
    "effects",
    "data_and_log_sinks",
    "deployment_targets",
    "compatibility_boundaries",
    "quality_claims",
    "acceptance_and_readiness_claims",
    "unknowns",
    "input_digest",
    "authored_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "target_footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "inclusions", "exclusions"],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pathBinding"}
        },
        "inclusions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/selectorBinding"}
        },
        "exclusions": {
          "type": "array",
          "items": {"$ref": "#/$defs/exclusionBinding"}
        }
      }
    },
    "source_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceBinding"}
    },
    "human_actors": {
      "type": "array",
      "items": {"$ref": "#/$defs/humanActor"}
    },
    "rendered_surfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/renderedSurface"}
    },
    "interfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/interface"}
    },
    "stores": {
      "type": "array",
      "items": {"$ref": "#/$defs/store"}
    },
    "queues": {
      "type": "array",
      "items": {"$ref": "#/$defs/queue"}
    },
    "writers": {
      "type": "array",
      "items": {"$ref": "#/$defs/writer"}
    },
    "normative_rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/normativeRule"}
    },
    "effects": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect"}
    },
    "data_and_log_sinks": {
      "type": "array",
      "items": {"$ref": "#/$defs/sink"}
    },
    "deployment_targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/deployment"}
    },
    "compatibility_boundaries": {
      "type": "array",
      "items": {"$ref": "#/$defs/compatibility"}
    },
    "quality_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "acceptance_and_readiness_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/acceptanceClaim"}
    },
    "unknowns": {
      "type": "array",
      "maxItems": 0
    },
    "input_digest": {"$ref": "#/$defs/digest"},
    "authored_by": {
      "allOf": [
        {"$ref": "#/$defs/id"},
        {"not": {"const": "invoke-design-scope-extractor"}}
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pathBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "selectorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "path", "digest"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "exclusionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "reason", "evidence_ref"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selector", "path", "digest"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "selector": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "signalBaseProperties": {
      "source_selector": {"type": "string", "minLength": 1},
      "source_digest": {"$ref": "#/$defs/digest"}
    },
    "humanActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "natural_person", "reads", "decides", "acts", "recovers", "navigates", "assistive_operation", "surfaces", "source_selector", "source_digest"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/id"},
        "natural_person": {"type": "boolean"},
        "reads": {"type": "boolean"},
        "decides": {"type": "boolean"},
        "acts": {"type": "boolean"},
        "recovers": {"type": "boolean"},
        "navigates": {"type": "boolean"},
        "assistive_operation": {"type": "boolean"},
        "surfaces": {"$ref": "#/$defs/stringSet"},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "renderedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "modality", "semantic_contract_ref", "semantic_change", "source_selector", "source_digest"],
      "properties": {
        "surface_id": {"$ref": "#/$defs/id"},
        "modality": {"type": "string", "minLength": 1},
        "semantic_contract_ref": {"type": "string", "minLength": 1},
        "semantic_change": {"enum": ["none", "new", "changed"]},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_id", "kind", "peer", "direction", "contract_ref", "source_selector", "source_digest"],
      "properties": {
        "interface_id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "peer": {"type": "string", "minLength": 1},
        "direction": {"enum": ["inbound", "outbound", "bidirectional"]},
        "contract_ref": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "authority", "data_classes", "writers", "source_selector", "source_digest"],
      "properties": {
        "store_id": {"$ref": "#/$defs/id"},
        "authority": {"type": "string", "minLength": 1},
        "data_classes": {"$ref": "#/$defs/stringSet"},
        "writers": {"$ref": "#/$defs/stringSet"},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "producers", "consumers", "ordering", "source_selector", "source_digest"],
      "properties": {
        "queue_id": {"$ref": "#/$defs/id"},
        "producers": {"$ref": "#/$defs/stringSet"},
        "consumers": {"$ref": "#/$defs/stringSet"},
        "ordering": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer_id", "targets", "concurrency", "source_selector", "source_digest"],
      "properties": {
        "writer_id": {"$ref": "#/$defs/id"},
        "targets": {"$ref": "#/$defs/stringSet"},
        "concurrency": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "normativeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "verb", "subject", "object", "enforcement_hint", "source_selector", "source_digest"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "verb": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "object": {"type": "string", "minLength": 1},
        "enforcement_hint": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "reversible", "external", "privileged", "source_selector", "source_digest"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/id"},
        "reversible": {"type": "boolean"},
        "external": {"type": "boolean"},
        "privileged": {"type": "boolean"},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sink_id", "data_classes", "retention_hint", "source_selector", "source_digest"],
      "properties": {
        "sink_id": {"$ref": "#/$defs/id"},
        "data_classes": {"$ref": "#/$defs/stringSet"},
        "retention_hint": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_id", "environment", "release_mode", "source_selector", "source_digest"],
      "properties": {
        "deployment_id": {"$ref": "#/$defs/id"},
        "environment": {"type": "string", "minLength": 1},
        "release_mode": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "old_contract", "new_contract", "source_selector", "source_digest"],
      "properties": {
        "boundary_id": {"$ref": "#/$defs/id"},
        "old_contract": {"type": "string", "minLength": 1},
        "new_contract": {"type": "string", "minLength": 1},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "source_kind", "threshold_or_tradeoff", "required", "source_selector", "source_digest"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "source_kind": {"type": "string", "minLength": 1},
        "threshold_or_tradeoff": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "acceptanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "selector", "evidence_state", "source_selector", "source_digest"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "selector": {"type": "string", "minLength": 1},
        "evidence_state": {"enum": ["authored-complete", "design-validator-pass"]},
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
