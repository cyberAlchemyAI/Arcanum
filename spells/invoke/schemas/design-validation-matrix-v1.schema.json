{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-validation-matrix/v1",
  "title": "Invoke Design Validation Matrix v1",
  "description": "Planned positive and negative validation case inventory. It records expected behavior but is not an execution result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "matrix_id",
    "schema_family",
    "cases",
    "execution_state",
    "authority_effect",
    "matrix_digest"
  ],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-validation-matrix/v1"},
    "schema_version": {"const": "invoke.design-validation-matrix.v1"},
    "matrix_id": {"$ref": "#/$defs/id"},
    "schema_family": {
      "type": "array",
      "prefixItems": [
        {"const": "invoke.design-production-process.v1"},
        {"const": "invoke.design-input-boundary-approval.v1"},
        {"const": "invoke.design-input-closure.v1"},
        {"const": "invoke.design-input-closure-receipt.v1"},
        {"const": "invoke.design-input-production-receipt.v1"},
        {"const": "invoke.design-profile.v1"},
        {"const": "invoke.design-source.v1"},
        {"const": "invoke.design-artifact.v1"},
        {"const": "invoke.design-coherence-policy.v1"},
        {"const": "invoke.design-coherence-receipt.v1"},
        {"const": "invoke.design-candidate-production-receipt.v1"},
        {"const": "invoke.design-stage-receipt.v1"},
        {"const": "invoke.design-validation-matrix.v1"}
      ],
      "items": false,
      "minItems": 13,
      "maxItems": 13
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "execution_state": {"const": "planned-unexecuted"},
    "authority_effect": {"const": "none"},
    "matrix_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmpty": {"type": "string", "pattern": ".*\\S.*"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "polarity", "target_schema", "fixture_ref", "mutation", "expected", "no_publication_on_failure"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "polarity": {"enum": ["positive", "negative"]},
        "target_schema": {"$ref": "#/$defs/id"},
        "fixture_ref": {"$ref": "#/$defs/exactRef"},
        "mutation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "selector", "value"],
              "properties": {
                "operation": {"enum": ["remove", "replace", "append"]},
                "selector": {"$ref": "#/$defs/nonEmpty"},
                "value": {}
              }
            }
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "diagnostic_code", "owner_stage"],
          "properties": {
            "valid": {"type": "boolean"},
            "diagnostic_code": {"oneOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}, {"type": "null"}]},
            "owner_stage": {"enum": ["schema", "input-closure", "source-validation", "artifact-projection", "coherence", "candidate-output-closure", "bundle-closure"]}
          }
        },
        "no_publication_on_failure": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"polarity": {"const": "positive"}}, "required": ["polarity"]},
          "then": {
            "properties": {
              "mutation": {"type": "null"},
              "expected": {"properties": {"valid": {"const": true}, "diagnostic_code": {"type": "null"}}},
              "no_publication_on_failure": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"polarity": {"const": "negative"}}, "required": ["polarity"]},
          "then": {
            "properties": {
              "mutation": {"type": "object"},
              "expected": {"properties": {"valid": {"const": false}, "diagnostic_code": {"type": "string"}}},
              "no_publication_on_failure": {"const": true}
            }
          }
        }
      ]
    }
  }
}
