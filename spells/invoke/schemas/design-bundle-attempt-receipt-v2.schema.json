{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v2",
  "title": "Invoke Design Bundle Attempt Receipt v2",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "receipt_id", "producer", "bundle_closure_ref", "candidate_receipt_ref", "stage_results", "outputs", "result", "next_route", "blockers", "evidence_ceiling", "authority_effect", "receipt_digest"],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v2"}, "schema_version": {"const": "invoke.design-bundle-attempt-receipt.v2"}, "receipt_id": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/id"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["identity", "owner", "path", "sha256"], "properties": {"identity": {"const": "invoke.compile-design-source.v3"}, "owner": {"const": "invoke-design-producer"}, "path": {"const": "arcanum/spells/invoke/scripts/compile_design_source_v3.py"}, "sha256": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/digest"}}},
    "bundle_closure_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/exactRef"}, "candidate_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/exactRef"},
    "stage_results": {"type": "array", "prefixItems": [{"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/stageResult"}, {"properties": {"stage_id": {"const": "bundle-closure-validation"}}}]}, {"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/stageResult"}, {"properties": {"stage_id": {"const": "view-projection"}}}]}, {"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/stageResult"}, {"properties": {"stage_id": {"const": "distill-evidence-validation"}}}]}, {"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/stageResult"}, {"properties": {"stage_id": {"const": "bundle-output-closure"}}}]}, {"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/stageResult"}, {"properties": {"stage_id": {"const": "late-finalization"}}}]}], "items": false, "minItems": 5, "maxItems": 5, "contains": {"type": "object", "properties": {"status": {"const": "block"}}, "required": ["status"]}, "minContains": 1, "maxContains": 1},
    "outputs": {"type": "array", "maxItems": 0}, "result": {"const": "block"}, "next_route": {"enum": ["repair-w2-candidate", "repair-distill-evidence", "repair-installed-contract", "repair-design-bundle"]}, "blockers": {"type": "array", "minItems": 1, "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/blocker"}}, "evidence_ceiling": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/blockEvidenceCeiling"}, "authority_effect": {"const": "none"}, "receipt_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-bundle-attempt-receipt/v1#/$defs/digest"}
  }
}
