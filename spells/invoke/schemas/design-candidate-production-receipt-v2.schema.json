{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v2",
  "title": "Invoke Design Candidate Production Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "receipt_id", "producer", "bindings", "source_ref", "w1_production_receipt_ref", "coherence_block_receipt", "stage_results", "outputs", "result", "next_route", "blockers", "evidence_ceiling", "authority_effect", "receipt_digest"],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v2"}, "schema_version": {"const": "invoke.design-candidate-production-receipt.v2"}, "receipt_id": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/id"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["identity", "owner", "path", "sha256"], "properties": {"identity": {"const": "invoke.compile-design-candidate.v2"}, "owner": {"const": "invoke-design-candidate-producer"}, "path": {"const": "arcanum/spells/invoke/scripts/compile_design_candidate_v2.py"}, "sha256": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/digest"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["process", "profile", "policy"], "properties": {"process": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/exactRef"}, "profile": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/exactRef"}, "policy": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/exactRef"}}},
    "source_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/exactRef"}, "w1_production_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/exactRef"}, "coherence_block_receipt": {"oneOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v2"}, {"type": "null"}]},
    "stage_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/stageResult"}},
    "outputs": {"type": "array", "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/outputRef"}, {"properties": {"kind": {"const": "design-artifact"}, "path": {"const": "DESIGN.json"}}}]}, {"allOf": [{"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/outputRef"}, {"properties": {"kind": {"const": "coherence-receipt"}, "path": {"const": "DESIGN-COHERENCE-RECEIPT.json"}}}]}], "items": false},
    "result": {"enum": ["pass", "block"]}, "next_route": {"enum": ["design-bundle-production", "repair-w1-input", "repair-installed-contract", "repair-design-source"]}, "blockers": {"type": "array", "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/blocker"}}, "evidence_ceiling": {"$ref": "#/$defs/ceiling"}, "authority_effect": {"const": "none"}, "receipt_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-candidate-production-receipt/v1#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"result": {"const": "pass"}}, "required": ["result"]}, "then": {"properties": {"stage_results": {"items": {"properties": {"status": {"const": "pass"}}}}, "outputs": {"minItems": 2}, "next_route": {"const": "design-bundle-production"}, "blockers": {"maxItems": 0}, "coherence_block_receipt": {"type": "null"}}}},
    {"if": {"properties": {"result": {"const": "block"}}, "required": ["result"]}, "then": {"properties": {"outputs": {"maxItems": 0}, "blockers": {"minItems": 1}}}}
  ],
  "$defs": {"ceiling": {"type": "object", "additionalProperties": false, "required": ["normal_w1_bound", "source_complete", "candidate_projected", "coherence_validated", "human_views_produced", "design_stage_pass", "plan_evidence", "acceptance", "execution", "publication", "deployment", "external_effect"], "properties": {"normal_w1_bound": {"type": "boolean"}, "source_complete": {"type": "boolean"}, "candidate_projected": {"type": "boolean"}, "coherence_validated": {"type": "boolean"}, "human_views_produced": {"const": false}, "design_stage_pass": {"const": false}, "plan_evidence": {"const": false}, "acceptance": {"const": false}, "execution": {"const": false}, "publication": {"const": false}, "deployment": {"const": false}, "external_effect": {"const": false}}}}
}
