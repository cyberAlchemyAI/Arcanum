{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/plan-consumer-applicability/v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "source_id", "consumers", "authority_effect"],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/plan-consumer-applicability/v1"},
    "schema_version": {"const": "invoke.plan-consumer-applicability.v1"},
    "source_id": {"type": "string", "minLength": 1},
    "consumers": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["consumer", "state", "predicate_inputs", "reason", "projection_paths", "validator", "result", "failure_route"], "properties": {"consumer": {"enum": ["wpra", "implementation-readiness", "task-session", "context-builder", "dispatch-spec", "goal", "signal-observer"]}, "state": {"enum": ["applicable", "not_applicable", "blocked"]}, "predicate_inputs": {"type": "object"}, "reason": {"type": "string", "minLength": 1}, "projection_paths": {"type": "array", "items": {"type": "string"}}, "validator": {"type": "object", "additionalProperties": false, "required": ["identity", "path", "sha256", "size"], "properties": {"identity": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 1}}}, "result": {"enum": ["pass", "negative_evidence", "block"]}, "failure_route": {"type": "string", "minLength": 1}}}},
    "authority_effect": {"const": "none"}
  }
}
