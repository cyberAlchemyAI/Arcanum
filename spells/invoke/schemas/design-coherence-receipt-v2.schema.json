{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v2",
  "title": "Invoke Design Coherence Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "receipt_id", "validator", "bindings", "policy_rule_ids", "policy_rule_set_digest", "evaluated_rules", "verdict", "diagnostics", "selection_evidence_state", "coherence_state", "design_stage_state", "plan_evidence_state", "authority_effect", "receipt_digest"],
  "properties": {
    "$schema": {"const": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v2"}, "schema_version": {"const": "invoke.design-coherence-receipt.v2"},
    "receipt_id": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/id"},
    "validator": {"type": "object", "additionalProperties": false, "required": ["identity", "owner", "path", "sha256"], "properties": {"identity": {"const": "invoke.validate-design-coherence.v2"}, "owner": {"const": "invoke-design-coherence-validator"}, "path": {"const": "arcanum/spells/invoke/scripts/validate_design_coherence_v2.py"}, "sha256": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/digest"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["process_ref", "profile_ref", "coherence_policy_ref", "design_input_production_receipt_ref", "design_input_closure_ref", "design_input_closure_receipt_ref", "scope_manifest_ref", "denominator_receipt_ref", "selection_result_ref", "design_source_ref", "design_artifact_ref"], "properties": {"process_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "profile_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "coherence_policy_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "design_input_production_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "design_input_closure_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "design_input_closure_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "scope_manifest_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "denominator_receipt_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "selection_result_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "design_source_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}, "design_artifact_ref": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/exactRef"}}},
    "policy_rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/id"}}, "policy_rule_set_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/digest"}, "evaluated_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/ruleResult"}}, "verdict": {"enum": ["pass", "flag", "block"]}, "diagnostics": {"type": "array", "items": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/diagnostic"}}, "selection_evidence_state": {"const": "design-validator-pass"}, "coherence_state": {"enum": ["pass", "flag", "block"]}, "design_stage_state": {"enum": ["pending-bundle-closure", "ineligible"]}, "plan_evidence_state": {"const": "plan-evidence-pending"}, "authority_effect": {"const": "none"}, "receipt_digest": {"$ref": "https://arcanum.dev/schemas/invoke/design-coherence-receipt/v1#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "pass"}}, "required": ["verdict"]}, "then": {"properties": {"evaluated_rules": {"items": {"properties": {"status": {"const": "pass"}}}}, "diagnostics": {"maxItems": 0}, "coherence_state": {"const": "pass"}, "design_stage_state": {"const": "pending-bundle-closure"}}}},
    {"if": {"properties": {"verdict": {"enum": ["flag", "block"]}}, "required": ["verdict"]}, "then": {"properties": {"diagnostics": {"minItems": 1}, "design_stage_state": {"const": "ineligible"}}}}
  ]
}
