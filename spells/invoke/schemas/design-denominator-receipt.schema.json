{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/design-denominator-receipt/1-0-0",
  "title": "InvokeDesignDenominatorReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_input_digest",
    "manifest_authored_by",
    "detector_id",
    "detector_version",
    "detector_owner",
    "inspected_selectors",
    "extracted_signals",
    "authored_concern_ids",
    "denominator_signal_ids",
    "unbound_signal_ids",
    "missing_detector_inputs",
    "verdict",
    "diagnostics",
    "receipt_digest",
    "validator_owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "manifest_input_digest": {"$ref": "#/$defs/digest"},
    "manifest_authored_by": {
      "allOf": [
        {"$ref": "#/$defs/id"},
        {"not": {"const": "invoke-design-scope-extractor"}}
      ]
    },
    "detector_id": {"const": "invoke-design-scope-extractor"},
    "detector_version": {"type": "string", "minLength": 1},
    "detector_owner": {"const": "spellcraft"},
    "inspected_selectors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/selector"}
    },
    "extracted_signals": {
      "type": "array",
      "items": {"$ref": "#/$defs/signal"}
    },
    "authored_concern_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "denominator_signal_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "unbound_signal_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "missing_detector_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verdict": {"enum": ["pass", "block"]},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "validator_owner": {"const": "invoke-design-selection-validator"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "unbound_signal_ids": {"maxItems": 0},
          "missing_detector_inputs": {"maxItems": 0},
          "diagnostics": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"verdict": {"const": "block"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {"diagnostics": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "path", "source_digest"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "signal_class", "source_selector", "source_digest", "attributes"],
      "properties": {
        "signal_id": {"$ref": "#/$defs/id"},
        "signal_class": {
          "enum": [
            "human-actor",
            "rendered-surface",
            "interface",
            "store",
            "queue",
            "writer",
            "normative-rule",
            "effect",
            "data-log-sink",
            "deployment",
            "compatibility",
            "quality-claim",
            "acceptance-readiness-claim"
          ]
        },
        "source_selector": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "attributes": {"type": "object"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "selector", "repair"],
      "properties": {
        "code": {
          "enum": [
            "MANIFEST_NOT_CLOSED",
            "MISSING_DETECTOR_INPUT",
            "STALE_DENOMINATOR_RECEIPT",
            "SELF_ISSUED_RECEIPT",
            "UNBOUND_SIGNAL"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "selector": {"type": ["string", "null"]},
        "repair": {"type": "string", "minLength": 1}
      }
    }
  }
}
