{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/invoke/tournament-source-binding-concept",
  "title": "Tournament Source Binding Concept",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept", "consumer"],
  "properties": {
    "concept": {
      "type": "object",
      "required": ["id", "meaning", "authority"]
    },
    "consumer": {
