    },
    {
      "facet_id": "validation-gates",
      "status": "represented",
      "evidence_source_ids": [
        "source:complexity-example-ladder-skill",
        "source:complexity-example-ladder-readme",
        "source:complexity-example-ladder-template"
      ],
      "rationale": "A passing ladder requires all three rungs, structural increase at each transition, invariant preservation, even required-option coverage, zero hidden unsupported claims, preserved decision semantics, and decision effect none; insufficient evidence without a safely labeled hypothetical requires BLOCK."
    },
    {
      "facet_id": "execution-handoff",
      "status": "represented",
      "evidence_source_ids": [
        "source:complexity-example-ladder-skill",
        "source:complexity-example-ladder-readme"
      ],
      "rationale": "The ladder returns its explanatory result and control to the caller, or requests missing evidence after BLOCK, without selecting, recording, admitting, executing, or authorizing an option."
