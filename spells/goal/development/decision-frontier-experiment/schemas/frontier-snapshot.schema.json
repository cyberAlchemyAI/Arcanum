{
  "$id": "https://arcanum.dev/experiments/frontier-snapshot/1-0-0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "frontier_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "kind": {
      "const": "frontier_snapshot"
    },
    "nodes": {
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source_digest",
    "nodes",
    "frontier_ids"
  ],
  "type": "object"
}
