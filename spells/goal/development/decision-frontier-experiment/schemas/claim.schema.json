{
  "$id": "https://arcanum.dev/experiments/claim/1-0-0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "kind": {
      "const": "claim"
    },
    "owner": {
      "type": "string"
    },
    "previous_store_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "active"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "claim_id",
    "decision_id",
    "source_digest",
    "owner",
    "claimed_at",
    "status",
    "previous_store_digest"
  ],
  "type": "object"
}
