{
  "$id": "https://arcanum.dev/experiments/resolution/1-0-0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array"
    },
    "decision_id": {
      "type": "string"
    },
    "kind": {
      "const": "resolution"
    },
    "owner": {
      "type": "string"
    },
    "resolution_id": {
      "type": "string"
    },
    "route": {
      "enum": [
        "HITL",
        "AFK"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "resolution_id",
    "decision_id",
    "source_digest",
    "owner",
    "route",
    "actions"
  ],
  "type": "object"
}
