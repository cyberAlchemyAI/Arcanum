{
  "$id": "https://arcanum.dev/experiments/way-clear/1-0-0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "way_clear"
    },
    "remaining": {
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "clear",
        "blocked"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source_digest",
    "status",
    "remaining"
  ],
  "type": "object"
}
