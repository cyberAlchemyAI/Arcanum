      ]
    },
    {
      "step_id": "s2-define",
      "name": "Define the decision-frontier experiment",
      "capability_ref": "invoke",
      "mode": "define",
      "pattern": "sequential",
      "parallel": false,
      "depends_on_steps": ["s1-context"],
      "techniques": [
        "sequence",
        "handle_handoff",
        "residue_ledger",
        "authority_split_gate"
