{
  "$schema": "../../../../../formulae/dispatch-spec/dispatch.schema.yml",
  "dispatch_id": "invoke-goal-decision-frontier-experiment-2026-07-30",
  "parent_dispatch_id": null,
  "intent": {
    "raw": "Define, design, and plan an experiment applying a Wayfinder-style DAG operational view to Invoke, Craft, and Goal.",
    "objective": "Produce a validated fixture-only Goal decision-frontier experiment package and route any later mutation to Spellcraft.",
    "target_artifact": "spells/goal/development/invoke-runs/20260730T171428Z-decision-frontier-experiment/WORK-PACK.md",
    "arcanum_vocabulary": [
      "spell",
      "decision frontier",
      "Craft ledger",
      "SWU",
      "Task Session",
      "receipt"
    ],
    "operator_sentence": "Invoke defines the cross-capability decision protocol, selects its architecture through the official denominator, plans serial fixture-backed SWUs, validates atomicity through Distill, and hands lifecycle review to Spellcraft."
  },
  "mode": "sequence",
  "route_class": "native-capability-sequence",
  "techniques": [
    "sequence",
    "frame_handoff",
    "handle_handoff",
    "residue_ledger",
    "scu_swu_reduction",
    "recomposition_proof",
    "validation_loop",
    "concrete_path_evidence",
    "artifact_contract_bridge",
    "execution_receipt_handoff",
    "authority_split_gate",
    "state_namespace_boundary",
    "owner_boundary_check",
    "observability_grouping"
  ],
  "steps": [
