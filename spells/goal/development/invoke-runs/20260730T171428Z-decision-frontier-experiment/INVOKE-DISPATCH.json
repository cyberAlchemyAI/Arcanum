    {
      "gate_id": "g-selection",
      "kind": "human_approval",
      "owner": "user-and-spellcraft",
      "condition": "Exactly one eligible SWU must be explicitly selected after lifecycle acceptance; current selected_swu is none.",
      "on_fail": "ask"
    }
  ],
