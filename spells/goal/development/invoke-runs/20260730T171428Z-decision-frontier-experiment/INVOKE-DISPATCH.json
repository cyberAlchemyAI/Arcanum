  "gates": [
    {
      "gate_id": "g-define",
      "kind": "quality",
      "owner": "invoke",
      "condition": "Define artifacts state the destination, protocol, invariants, witnesses, residues, lifecycle owner, and evidence ceiling.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-design",
      "kind": "validation",
      "owner": "invoke",
      "condition": "The official denominator and selection validators pass twice with byte-identical results and one fixed point.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-plan",
      "kind": "quality",
      "owner": "invoke",
      "condition": "Four layers, exact task scopes, serial waves, closeout receipts, Distill proof, and traceability are complete.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-distill",
      "kind": "validation",
      "owner": "distill",
      "condition": "The first candidate is narrow and reversible; all units are atomic and recompose to the selected design.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-lifecycle",
      "kind": "promotion_guardrail",
      "owner": "spellcraft",
      "condition": "Invoke provides planning evidence only; Spellcraft separately decides experiment admission and any later refresh.",
      "on_fail": "block"
