      "outputs": [
        {"kind": "handoff", "ref": "PLAN-TRANSPORT.md"},
        {"kind": "receipt", "ref": "INVOKE-RESULT.md"}
      ],
      "join_policy": "none",
      "stop_conditions": [
        "Plan or Distill validation does not pass.",
        "The handoff implies lifecycle acceptance or SWU selection."
      ]
    }
