        {"kind": "artifact", "ref": "IMPLEMENTATION-LAYERING.md"},
        {"kind": "artifact", "ref": "IMPLEMENTATION-PLAN.md"},
        {"kind": "artifact", "ref": "WORK-PACK.md"},
        {"kind": "artifact", "ref": "EXECUTION-PACK.md"},
        {"kind": "artifact", "ref": "VALIDATION-STRATEGY.md"}
