{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.dev/schemas/goal/plan-route-contract/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "frontier", "owner", "expected_receipt", "gate", "stop", "fallback", "authority_effect"],
  "properties": {
    "schema_version": {"const": "goal.plan-route-contract.v1"},
    "frontier": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owner": {"type": "string", "minLength": 1},
    "expected_receipt": {"type": "string", "minLength": 1},
    "gate": {"type": "string", "minLength": 1},
    "stop": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}
